@@ -0,0 +1,383 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Workload timer (workload-v2): opt-in marks/spans, their seams in the worker and stages, and the resolve schema.
+
+Without a timer every hook is a no-op and the code paths are unchanged; with one, ``t1_dispatch`` (worker entry),
+``t2_first_new_denoise`` (first denoise forward, never a clean context/recache forward), ``vae_begin`` / ``vae_end``
+(decoding stage) and ``rgb_ready`` (uint8 RGB on the CPU) are recorded in that order and resolved into
+``req.extra["wl_timing"]``. CUDA events are checked when a GPU is present.
+"""
+
+import contextlib
+import copy
+import pickle
+import time
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from sglang.multimodal_gen.runtime.layers.kvcache import causal_kv_backend as seam
+from sglang.multimodal_gen.runtime.managers.gpu_worker import GPUWorker
+from sglang.multimodal_gen.runtime.pipelines_core.schedule_batch import OutputBatch
+from sglang.multimodal_gen.runtime.pipelines_core.stages import decoding
+from sglang.multimodal_gen.runtime.pipelines_core.stages.causal_denoising import (
+    CausalDMDDenoisingStage,
+)
+from sglang.multimodal_gen.runtime.utils import workload_timer as wt
+
+CUDA = torch.cuda.is_available()
+MARK_ORDER = ["t1_dispatch", "t2_first_new_denoise", "vae_begin", "vae_end", "rgb_ready"]
+
+
+@pytest.fixture(autouse=True)
+def _no_env_timer(monkeypatch):
+    monkeypatch.delenv(wt.WL_TIMER_ENV, raising=False)
+
+
+def _check_schema(resolved):
+    assert set(resolved) == {"marks", "spans"}
+    for name, mark in resolved["marks"].items():
+        assert isinstance(name, str) and set(mark) == {"host_ns", "gpu_ms_from_t1"}
+        assert type(mark["host_ns"]) is int
+        assert mark["gpu_ms_from_t1"] is None or type(mark["gpu_ms_from_t1"]) is float
+    for span in resolved["spans"]:
+        assert set(span) == {"name", "host_start_ns", "host_end_ns", "gpu_ms"}
+        assert type(span["host_start_ns"]) is int and type(span["host_end_ns"]) is int
+        assert span["host_start_ns"] <= span["host_end_ns"]
+        assert span["gpu_ms"] is None or type(span["gpu_ms"]) is float
+
+
+# --- the timer itself ------------------------------------------------------------------------------------------------
+
+
+def test_absent_timer_is_a_noop_and_touches_nothing():
+    req = SimpleNamespace(extra={})
+    assert wt.attach_workload_timer(req) is None and req.extra == {}
+    assert wt.workload_timer(req) is None
+    wt.wl_mark(req, "t1_dispatch")
+    with wt.wl_span(req, "text_encode"):
+        pass
+    assert req.extra == {}
+    for batch in (SimpleNamespace(), SimpleNamespace(extra=None), SimpleNamespace(extra={"wl_timer": "other"})):
+        assert wt.workload_timer(batch) is None
+        wt.wl_mark(batch, "vae_begin")  # no error, nothing recorded
+    assert wt.current_workload_timer() is None
+    req.extra["workload_timing"] = "yes"  # only True opts in
+    assert wt.attach_workload_timer(req) is None
+
+
+def test_opt_in_by_request_or_environment(monkeypatch):
+    req = SimpleNamespace(extra={"workload_timing": True})
+    timer = wt.attach_workload_timer(req)
+    assert isinstance(timer, wt.WorkloadTimer) and req.extra["wl_timer"] is timer
+    assert wt.workload_timer(req) is timer
+    assert wt.attach_workload_timer(req) is not timer  # every dispatch gets a fresh timer
+    plain = SimpleNamespace(extra={})
+    monkeypatch.setenv(wt.WL_TIMER_ENV, "1")
+    assert wt.attach_workload_timer(plain) is plain.extra["wl_timer"]
+    monkeypatch.setenv(wt.WL_TIMER_ENV, "0")
+    assert wt.attach_workload_timer(SimpleNamespace(extra={})) is None
+
+
+@pytest.mark.parametrize("cuda", [False] + ([True] if CUDA else []))
+def test_marks_spans_order_and_resolve_schema(cuda):
+    timer = wt.WorkloadTimer(cuda=cuda)
+    device = "cuda" if cuda else "cpu"
+    work = torch.randn(256, 256, device=device)
+    timer.mark("t1_dispatch")
+    with timer.span("text_encode"):
+        work = work @ work
+    with timer.span("text_encode_cached"):
+        pass
+    for name in MARK_ORDER[1:]:
+        work = work @ work
+        timer.mark(name)
+        time.sleep(0.001)
+    timer.mark("t2_first_new_denoise")  # a name is recorded once: the first occurrence counts
+    resolved = timer.resolve()
+    _check_schema(resolved)
+    assert list(resolved["marks"]) == MARK_ORDER
+    hosts = [resolved["marks"][name]["host_ns"] for name in MARK_ORDER]
+    assert hosts == sorted(hosts) and len(set(hosts)) == len(hosts)
+    assert [span["name"] for span in resolved["spans"]] == ["text_encode", "text_encode_cached"]
+    gpu = [resolved["marks"][name]["gpu_ms_from_t1"] for name in MARK_ORDER]
+    if cuda:
+        assert gpu[0] == 0.0 and gpu == sorted(gpu) and all(value >= 0.0 for value in gpu)
+        assert all(span["gpu_ms"] >= 0.0 for span in resolved["spans"])
