+@pytest.mark.parametrize("device", ["cpu"] + (["cuda"] if CUDA else []))
+def test_worker_dispatch_rgb_and_resolved_timing(device):
+    frames = torch.rand(1, 3, 5, 4, 6, device=device)
+    marks_during_forward = []
+
+    def forward(req, server_args):
+        timer = wt.workload_timer(req)
+        marks_during_forward.append(None if timer is None else list(timer.resolve()["marks"]))
+        if timer is not None:
+            for name in ("t2_first_new_denoise", "vae_begin", "vae_end"):
+                timer.mark(name)
+        return OutputBatch(output=frames.clone())
+
+    worker = _worker(forward)
+    plain = _req()
+    out_plain = worker.execute_forward([plain])
+    assert plain.extra == {} and marks_during_forward[-1] is None
+    timed = _req(workload_timing=True)
+    out_timed = worker.execute_forward([timed])
+    assert marks_during_forward[-1] == ["t1_dispatch"]
+    resolved = timed.extra["wl_timing"]
+    _check_schema(resolved)
+    assert list(resolved["marks"]) == MARK_ORDER
+    hosts = [resolved["marks"][name]["host_ns"] for name in MARK_ORDER]
+    assert hosts == sorted(hosts)
+    if device == "cuda":
+        gpu = [resolved["marks"][name]["gpu_ms_from_t1"] for name in MARK_ORDER]
+        assert gpu[0] == 0.0 and gpu == sorted(gpu)
+    # the uint8 [F, H, W, 3] CPU frames are the same with and without the timer
+    [rgb_plain], [rgb_timed] = out_plain.output, out_timed.output
+    assert isinstance(rgb_timed, np.ndarray) and rgb_timed.dtype == np.uint8 and rgb_timed.shape == (5, 4, 6, 3)
+    assert np.array_equal(rgb_plain, rgb_timed)
+    expected = (frames[0] * 255).clamp(0, 255).to(torch.uint8).permute(1, 2, 3, 0).cpu().numpy()
+    assert np.array_equal(rgb_timed, expected)
+
