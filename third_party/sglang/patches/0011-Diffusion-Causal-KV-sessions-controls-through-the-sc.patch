+def test_session_endpoints_map_typed_errors_to_http(monkeypatch):
+    sent = []
+
+    async def forward(req, timeout_ms=None):
+        sent.append(req)
+        if req.args.get("session_id") == "missing":
+            error = {"code": "unknown_session", "status": 404, "message": "unknown"}
+            return OutputBatch(error="unknown", output={"error": error})
+        if req.op == "close" and req.args.get("session_id") == "busy":
+            error = {"code": "busy", "status": 409, "message": "running"}
+            return OutputBatch(error="running", output={"error": error})
+        return OutputBatch(output={"op": req.op, **req.args})
+
+    monkeypatch.setattr(session_api.async_scheduler_client, "forward", forward)
+    app = FastAPI()
+    app.include_router(session_api.router)
+    client = TestClient(app)
+    assert client.get("/v1/sessions").json() == {"op": "list"}
+    assert client.get("/v1/sessions/s1?history=3").json() == {
+        "op": "describe",
+        "session_id": "s1",
+        "history": 3,
+    }
+    assert (
+        client.post("/v1/sessions/s1/checkpoints", json={"name": "c1"}).json()["name"]
+        == "c1"
+    )
+    assert (
+        client.post(
+            "/v1/sessions/s1/fork", json={"target": "f", "checkpoint": 2}
+        ).json()["checkpoint"]
+        == 2
+    )
+    assert (
+        client.post("/v1/sessions/s1/rewind", json={"checkpoint": "c1"}).json()["op"]
+        == "rewind"
+    )
+    assert (
+        client.post("/v1/sessions/s1/close", json={"mode": "abort"}).json()["mode"]
+        == "abort"
+    )
+    assert client.delete("/v1/sessions/s1/checkpoints/c1").json() == {
+        "op": "delete",
+        "session_id": "s1",
+        "checkpoint": "c1",
+        "gc": True,
+    }
+    assert client.get("/v1/session_requests/r1").json() == {
+        "op": "request",
+        "request_id": "r1",
+    }
+    assert client.post("/v1/session_gc").json() == {"op": "gc"}
+    missing = client.get("/v1/sessions/missing")
+    assert (
+        missing.status_code == 404
+        and missing.json()["detail"]["code"] == "unknown_session"
+    )
+    assert client.post("/v1/sessions/busy/close").status_code == 409
+    assert (
+        client.post(
