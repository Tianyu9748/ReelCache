+    def _begin_causal_kv_early_restore(self, req) -> bool:
+        """PROTOTYPE (``reelcache-overlap-proto``): let a causal stage start the session request's restore now,
+        before text encoding and latent preparation (``begin_causal_kv_early_restore``). True when offered."""
+        if req.is_warmup or getattr(req, "causal_kv_session", None) is None:
+            return False
+        if not callable(getattr(self.causal_kv_backend, "early_restore", None)):
+            return False
+        for stage in getattr(self.pipeline, "stages", ()):
+            begin = getattr(stage, "begin_causal_kv_early_restore", None)
+            if callable(begin):
+                try:
+                    with current_platform.inference_mode():  # the stage caches are inference tensors
