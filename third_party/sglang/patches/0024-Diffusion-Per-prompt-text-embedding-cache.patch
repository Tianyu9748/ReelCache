+def test_prompt_lists_are_served_per_prompt_and_never_depend_on_the_cache_state(cache_bytes, device):
+    encoder = BatchVariantEncoder().to(device)
+    stage, args = make_stage([encoder]), make_args()
+    history = ["shot A", "shot A", "cut: shot B", "cut: shot C"]
+    batched = encode(stage, history, args, device)  # cache off: one batched call
+    per_prompt = [encode(stage, [p], args, device) for p in history]  # cache off: one call per prompt
+    reference = te._stack_rows(per_prompt)
+    cache = cache_bytes(1 << 20)
+    encoder.calls.clear()
+    cold = encode(stage, history, args, device)
+    assert encoder.calls == [1, 1, 1]  # each distinct prompt alone, once
+    assert_bitwise(cold, reference)
+    # the batch-variant encoder: a batched call differs from per-prompt calls (documented semantics)
+    assert not torch.equal(cold[0][0], batched[0][0])
+    warm = encode(stage, history, args, device)
+    assert encoder.calls == [1, 1, 1]
+    assert_bitwise(warm, cold)
+    # a request one shot deeper: the historical shots hit, only the new one is encoded
+    deeper = history + ["cut: shot D"]
+    grown = encode(stage, deeper, args, device)
+    assert encoder.calls == [1, 1, 1, 1]
+    cache.clear()
+    encoder.calls.clear()
+    assert_bitwise(encode(stage, deeper, args, device), grown)  # cold == warm, bitwise
+    assert encoder.calls == [1, 1, 1, 1]
+    assert cache.stats()["hits"] == 3 + 3 and cache.stats()["misses"] == 3 + 1 + 4
