+    def _position_shadow(self) -> "CausalSelfAttentionKVCache":
+        """An empty CPU cache of this geometry whose keys record global token positions."""
+        if self.allow_growth:
+            raise NotImplementedError(
+                "restoring a growable causal KV cache is not supported"
+            )
+        positions = torch.full((1, self.cache_size, 1, 1), -1.0, dtype=torch.float64)
+        return CausalSelfAttentionKVCache(
+            k=positions,
+            v=positions.clone(),
+            global_end_index=torch.zeros(1, dtype=torch.long),
+            local_end_index=torch.zeros(1, dtype=torch.long),
+            global_end_index_int=0,
+            local_end_index_int=0,
+            cache_size=self.cache_size,
+            sink_tokens=self.sink_tokens,
+            attention_window_size=self.attention_window_size,
+            allow_growth=False,
+            global_sink_tokens=self.global_sink_tokens,
+        )
+
+    def replay_layout(
+        self,
+        appends: Sequence[tuple[int, int, bool]],
+        *,
+        next_chunk: tuple[int, int] | None = None,
+    ) -> CausalKVCacheLayout:
+        """Slot layout after appending ``appends`` to an empty cache of this geometry.
+
+        Replays this class's own cursor, eviction and pinned-sink logic on a CPU
+        shadow whose keys are global token positions, so a restore rebuilds
+        exactly the slots native generation holds. ``appends`` are the clean
+        chunk writes ``(token_start, num_tokens, pinned_after_write)`` in order.
+        ``next_chunk=(token_start, num_tokens)`` also computes ``attended``.
+        """
+        shadow = self._position_shadow()
+        for token_start, num_tokens, pinned in appends:
+            ids = torch.arange(
+                token_start, token_start + num_tokens, dtype=torch.float64
+            ).view(1, -1, 1, 1)
+            shadow.update_and_get_attention_kv(
+                key=ids,
+                value=ids,
+                current_chunk_start=token_start,
+                debug_name="causal KV layout replay",
+            )
+            if pinned:
+                shadow.pin_current_chunk(num_tokens)
+        global_end, local_end = shadow._read_indices()
+        positions = [int(item) for item in shadow.k[0, :local_end, 0, 0].tolist()]
+        if len(set(positions)) != len(positions) or min(positions, default=0) < 0:
+            raise RuntimeError("causal KV layout replay produced duplicate or unset slots")
+        attended = None
+        if next_chunk is not None:
+            token_start, num_tokens = next_chunk
+            probe = CausalSelfAttentionKVCache(
+                k=shadow.k.clone(),
+                v=shadow.v.clone(),
+                global_end_index=shadow.global_end_index.clone(),
+                local_end_index=shadow.local_end_index.clone(),
+                global_end_index_int=global_end,
+                local_end_index_int=local_end,
+                cache_size=shadow.cache_size,
+                sink_tokens=shadow.sink_tokens,
+                attention_window_size=shadow.attention_window_size,
+                allow_growth=False,
+                global_sink_tokens=shadow.global_sink_tokens,
+                pinned_start=shadow.pinned_start,
+                pinned_len=shadow.pinned_len,
+            )
+            ids = torch.arange(
+                token_start, token_start + num_tokens, dtype=torch.float64
+            ).view(1, -1, 1, 1)
+            view = probe.update_and_get_attention_kv(
+                key=ids,
+                value=ids,
+                current_chunk_start=token_start,
+                debug_name="causal KV next-chunk replay",
+            )
+            read = {int(item) for item in view.k[0, :, 0, 0].tolist()}
+            read -= set(range(token_start, token_start + num_tokens))
+            attended = _position_spans(positions, read)
+        return CausalKVCacheLayout(
+            cache_size=self.cache_size,
+            sink_tokens=self.sink_tokens,
+            global_sink_tokens=self.global_sink_tokens,
+            attention_window_size=self.attention_window_size,
+            global_end_index=global_end,
+            local_end_index=local_end,
+            pinned_start=shadow.pinned_start,
+            pinned_len=shadow.pinned_len,
+            live=_position_spans(positions),
+            attended=attended,
+        )
+
+    def install_restored_history(
+        self,
+        layout: CausalKVCacheLayout,
+        write: Callable[[CausalKVSlotSpan, torch.Tensor, torch.Tensor], None],
+    ) -> None:
+        """Install restored post-RoPE K and V into a freshly reset cache.
+
+        Live slots are zeroed, ``write(span, k_slots, v_slots)`` fills every
+        attended span (all live spans when ``layout.attended`` is None) through
+        ``[B, span.length, H, D]`` views of this cache, then the write cursors
+        and pinned shot sink are set, honoring the sink/window geometry.
+        """
+        if (
+            layout.cache_size,
+            layout.sink_tokens,
+            layout.global_sink_tokens,
+            layout.attention_window_size,
+        ) != (
+            self.cache_size,
+            self.sink_tokens,
+            self.global_sink_tokens,
+            self.attention_window_size,
+        ) or self.allow_growth:
+            raise ValueError("restored layout does not match this cache's geometry")
+        if self._read_indices() != (0, 0) or self._has_pinned_sink():
+            raise RuntimeError("restored history is installed only into a reset cache")
+        local_end = layout.local_end_index
+        if not 0 <= local_end <= self.cache_size or layout.global_end_index < local_end:
+            raise ValueError("restored layout cursors are outside the cache")
+        live = {
+            slot: span.global_start + slot - span.local_start
+            for span in layout.live
+            for slot in range(span.local_start, span.local_end)
+        }
+        if sorted(live) != list(range(local_end)):
+            raise ValueError("restored layout must cover exactly the live slots")
+        spans = layout.live if layout.attended is None else layout.attended
+        for span in spans:
+            if span.length <= 0 or any(
+                live.get(slot) != span.global_start + slot - span.local_start
+                for slot in (span.local_start, span.local_end - 1)
+            ):
+                raise ValueError("restored span is not part of the live layout")
+        self.k[:, :local_end].zero_()
+        self.v[:, :local_end].zero_()
+        for span in spans:
+            write(
+                span,
+                self.k[:, span.local_start : span.local_end],
+                self.v[:, span.local_start : span.local_end],
+            )
+        self._write_indices(
+            global_end_index=layout.global_end_index, local_end_index=local_end
+        )
+        self.pinned_start = layout.pinned_start
+        self.pinned_len = layout.pinned_len
+
 
