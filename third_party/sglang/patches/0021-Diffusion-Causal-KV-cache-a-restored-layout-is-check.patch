         assert _outcome(_per_slot_check, layout) is None and _outcome(_check_restored_layout, layout) is None
 
 
+def test_install_zeroes_only_the_live_slots_no_span_writes():
+    """The attended slots are left to the restore (never written here, so they keep what the buffer held), the live
+    slots the next chunk does not attend are zeroed, and slots past the cursor are untouched."""
+    from sglang.multimodal_gen.runtime.layers.kvcache.causal_attention_cache import (
+        _unwritten_slots,
+    )
+
+    chunks = CACHE_FRAMES // CHUNK_FRAMES + 1  # past a full window: live slots the next chunk does not read
+    cache = _cache()
+    layout = cache.replay_layout(
+        [(index * CHUNK, CHUNK, False) for index in range(chunks)],
+        next_chunk=(chunks * CHUNK, CHUNK),
+    )
+    holes = _unwritten_slots(layout)
+    assert holes
+    cache.k.fill_(5.0)  # a previous request's K/V; the cursors are reset
+    cache.v.fill_(5.0)
+    cache.install_restored_history(layout, lambda span, k, v: None)
+
+    def mask(intervals):
+        selected = torch.zeros(cache.cache_size, dtype=torch.bool)
+        for start, end in intervals:
+            selected[start:end] = True
+        return selected
+
+    zeroed = mask(holes)
+    attended = mask((span.local_start, span.local_end) for span in layout.attended)
+    live = mask((span.local_start, span.local_end) for span in layout.live)
+    assert not torch.any(zeroed & attended) and torch.equal(zeroed | attended, live)
+    for buffer in (cache.k, cache.v):
+        assert torch.all(buffer[0, zeroed] == 0) and torch.all(buffer[0, ~zeroed] == 5.0)
+    assert _unwritten_slots(_cache().replay_layout([(0, CHUNK, False)])) == ()  # all live slots written
+
+
+def test_a_layout_installed_into_every_layer_is_checked_once():
+    from sglang.multimodal_gen.runtime.layers.kvcache.causal_attention_cache import (
+        _checked_layout,
+    )
+
+    layout = _cache().replay_layout(
+        [(0, CHUNK, False), (CHUNK, CHUNK, False)], next_chunk=(2 * CHUNK, CHUNK)
+    )
+    _checked_layout.cache_clear()
+    for _ in range(30):
+        _cache().install_restored_history(layout, lambda span, k, v: None)
+    info = _checked_layout.cache_info()
+    assert (info.misses, info.hits) == (1, 29)
+
