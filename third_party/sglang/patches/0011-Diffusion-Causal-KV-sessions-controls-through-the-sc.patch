+class _Backend:
+    """A worker backend answering controls like ReelCache's bridge would."""
+
+    def __init__(self):
+        self.calls = []
+
+    def control(self, op, args):
+        self.calls.append(("control", op, args))
+        if args.get("session_id") == "missing":
+            error = RuntimeError("unknown causal KV session 'missing'")
+            error.to_dict = lambda: {
+                "code": "unknown_session",
+                "status": 404,
+                "message": str(error),
+            }
+            raise error
+        return {"op": op, **args}
+
+    def inflight_control(self, op, args):
+        self.calls.append(("inflight", op, args))
+        if op == "pause" and args.get("session_id") == "running":
+            return {"op": op, "status": "pause_requested", "deferred": True}
+        if op in ("describe", "list"):
+            return {"op": op, "status": "running"}
+        return None
+
+
+def _worker(backend):
+    worker = GPUWorker.__new__(GPUWorker)
+    worker.causal_kv_backend = backend
+    return worker
+
+
+def test_worker_maps_controls_and_typed_errors():
+    worker = _worker(_Backend())
+    ok = worker.causal_kv_session_control("describe", {"session_id": "s"})
+    assert ok.error is None and ok.output == {"op": "describe", "session_id": "s"}
+    failed = worker.causal_kv_session_control("describe", {"session_id": "missing"})
+    assert (
+        failed.output["error"]["code"] == "unknown_session"
+        and failed.output["error"]["status"] == 404
+    )
+    disabled = _worker(None).causal_kv_session_control("list", {})
+    assert disabled.error and disabled.output["error"]["code"] == "unsupported"
+    assert _worker(None).causal_kv_session_inflight("list", {}) is None
+    assert (
+        worker.causal_kv_session_inflight("checkpoint", {"session_id": "running"})
+        is None
+    )
+
+
+def _scheduler(worker, received):
+    scheduler = Scheduler.__new__(Scheduler)
+    scheduler.worker = worker
+    scheduler.metrics = None
+    scheduler.waiting_queue = deque([(b"earlier", "queued-before", 0.0)])
+    scheduler.replies = []
+    scheduler.recv_reqs = lambda: list(received)
+    scheduler.process_received_reqs_with_req_based_warmup = lambda reqs: reqs
+    scheduler.return_result = lambda output, identity, should_not_return=False: (
+        scheduler.replies.append((identity, output))
+    )
+    return scheduler
+
+
+def test_boundary_poll_defers_the_pause_and_serves_reads_in_flight():
+    backend = _Backend()
+    pause = CausalKVSessionControlReq(op="pause", args={"session_id": "running"})
+    describe = CausalKVSessionControlReq(op="describe", args={"session_id": "running"})
+    close = CausalKVSessionControlReq(op="close", args={"session_id": "running"})
+    generation = SimpleNamespace(is_warmup=False)
+    scheduler = _scheduler(
+        _worker(backend),
+        [(b"a", pause), (b"b", describe), (b"c", close), (b"d", generation)],
+    )
+    scheduler._poll_causal_kv_controls()
+    # The deferred pause runs first after the request (it then drains and replies durably).
+    assert [identity for identity, _, _ in scheduler.waiting_queue] == [
+        b"a",
+        b"earlier",
+        b"c",
+        b"d",
+    ]
+    assert [identity for identity, _ in scheduler.replies] == [b"b"]
+    assert scheduler.replies[0][1].output["status"] == "running"
+    handled = scheduler._handle_causal_kv_session_control([pause])
+    assert handled.output == {"op": "pause", "session_id": "running"}
+    assert Scheduler._has_causal_kv_session(
+        SimpleNamespace(causal_kv_session={"session_id": "s"})
+    )
+    assert not Scheduler._has_causal_kv_session(SimpleNamespace(causal_kv_session=None))
+
