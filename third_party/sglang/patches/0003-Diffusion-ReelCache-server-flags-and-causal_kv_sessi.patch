+# SPDX-License-Identifier: Apache-2.0
+"""Server configuration of the optional ReelCache causal KV archive backend.
+
+Typed plain data carried by ``ServerArgs.reelcache_config``. It never imports
+ReelCache: the GPU worker loads the backend only when ``enabled`` is true (see
+``runtime/layers/kvcache/causal_kv_backend.py``), and an enabled server whose
+backend cannot be imported fails at startup instead of running the dense path.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+from dataclasses import dataclass, field
+from typing import Any
+
+REELCACHE_BACKEND_MODULE = "reelcache.integrations.sglang"
+
+
+class ReelCacheUnavailableError(RuntimeError):
+    """ReelCache was requested (``--reelcache-enable``) but its SGLang backend cannot be loaded."""
+
+
+def _load_config(value: Any) -> dict[str, Any]:
+    if value is None:
+        return {}
+    if isinstance(value, dict):
+        config = value
+    elif isinstance(value, str):
+        text = value.strip()
+        if text.startswith("{"):
+            config = json.loads(text)
+        elif os.path.isfile(text):
+            with open(text, encoding="utf-8") as handle:
+                config = json.load(handle)
+        else:
+            raise ValueError(
+                "--reelcache-config must be a JSON object or the path of a JSON file, "
+                f"got {value!r}"
+            )
+    else:
+        raise TypeError("reelcache config must be a JSON object, a JSON string or a path")
+    if not isinstance(config, dict):
+        raise ValueError("--reelcache-config must decode to a JSON object")
+    # Round-trip: the backend receives plain JSON data only (no live objects).
+    return json.loads(json.dumps(config))
+
+
+@dataclass
+class ReelCacheArgs:
+    """``--reelcache-enable``, ``--reelcache-config`` and ``--reelcache-hevc-inter-prediction``."""
+
+    enabled: bool = False
+    config: dict[str, Any] = field(default_factory=dict)
+    hevc_inter_prediction: bool = False
+
+    def validate(self) -> "ReelCacheArgs":
+        if type(self.enabled) is not bool:
+            raise TypeError("reelcache enabled must be a bool")
+        if type(self.hevc_inter_prediction) is not bool:
+            raise TypeError("reelcache hevc_inter_prediction must be a bool")
+        self.config = _load_config(self.config)
+        if "hevc_inter_prediction" in self.config and (
+            self.config["hevc_inter_prediction"] != self.hevc_inter_prediction
+        ):
+            raise ValueError(
+                "set HEVC inter prediction with --reelcache-hevc-inter-prediction, "
+                "not inside --reelcache-config"
+            )
+        if not self.enabled and (self.config or self.hevc_inter_prediction):
+            raise ValueError(
+                "--reelcache-config/--reelcache-hevc-inter-prediction require --reelcache-enable"
+            )
+        return self
+
+    def backend_config(self) -> dict[str, Any]:
+        """Plain JSON configuration handed to the backend factory."""
+        return {**self.config, "hevc_inter_prediction": self.hevc_inter_prediction}
+
+    def require_available(self) -> None:
+        """Fail clearly when ReelCache is requested but not importable (no dense fallback)."""
+        if not self.enabled:
+            return
+        try:
+            spec = importlib.util.find_spec(REELCACHE_BACKEND_MODULE)
+        except (ImportError, ValueError) as exc:
+            raise ReelCacheUnavailableError(
+                f"--reelcache-enable was requested but {REELCACHE_BACKEND_MODULE} cannot be "
+                f"imported: {exc}"
+            ) from exc
+        if spec is None:
+            raise ReelCacheUnavailableError(
+                f"--reelcache-enable was requested but {REELCACHE_BACKEND_MODULE} is not "
+                "installed; refusing to run the dense KV path instead"
+            )
+
+    def describe(self) -> str:
+        if not self.enabled:
+            return "off"
+        return (
+            f"on hevc_inter_prediction={self.hevc_inter_prediction} "
+            f"config_keys={sorted(self.config)}"
+        )
+
+    @classmethod
+    def from_dict(cls, kwargs: dict[str, Any]) -> "ReelCacheArgs":
+        """Build from flat CLI kwargs (dest names ``reelcache_*``)."""
+        return cls(
+            enabled=bool(kwargs.get("reelcache_enable") or False),
+            config=kwargs.get("reelcache_config_json"),
+            hevc_inter_prediction=bool(
+                kwargs.get("reelcache_hevc_inter_prediction") or False
+            ),
+        ).validate()
