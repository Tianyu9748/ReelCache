+    @contextmanager
+    def _causal_kv_recache_scope(self, run, recache: CausalKVRecache):
+        """Capture the clean recache forward(s) run inside this block (every CFG stream).
+
+        For stages that re-materialize earlier frames (e.g. a LongLive 1.0
+        prompt-switch KV recache through ``_update_causal_context_cache``). On
+        success the backend archives only ``recache.written`` as a new cache
+        epoch; ``run=None`` (ordinary generation) captures nothing.
+        """
+        if run is None:
+            yield
+            return
+        previous = self._causal_kv_pending
+        self._causal_kv_pending = (run, recache)
+        try:
+            yield
+        finally:
+            self._causal_kv_pending = previous
+        run.end_recache(recache)
+
+    def _causal_kv_recache(
+        self,
+        batch: Req,
+        *,
+        window_start_frame: int,
+        window_frames: int,
+        written_frames: tuple[int, int],
+        pos_start_base: int,
+        epoch_id: str,
+        details: dict | None = None,
+    ) -> CausalKVRecache:
+        """Describe a recache forward over ``window_frames`` frames from ``window_start_frame``.
+
+        ``written_frames = (start, end)`` are the request frames whose new K/V the
+        cache stored (a sink-protected recompute skips the sink frames).
+        """
+        window = self._causal_kv_chunk(
+            batch,
+            block_index=-1,
+            start_frame=window_start_frame,
+            num_frames=window_frames,
+            pos_start_base=pos_start_base,
+            scene_cut=False,
+        )
+        start, end = written_frames
+        if not window_start_frame <= start < end <= window_start_frame + window_frames:
+            raise ValueError("recache written frames must lie inside the recache window")
+        tpf = self.num_token_per_frame
+        written = (((pos_start_base + start) * tpf, (end - start) * tpf),)
+        return CausalKVRecache(
+            window=window,
+            written=written,
+            epoch_id=epoch_id,
+            details=json.loads(json.dumps(details or {})),
+        )
 
