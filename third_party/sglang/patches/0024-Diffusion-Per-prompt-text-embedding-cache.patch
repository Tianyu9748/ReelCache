+@torch.no_grad()
+def test_per_prompt_subclass_and_conditioning_cache_compose(cache_bytes):
+    """A stage that encodes each prompt in its own call (ReelCache's causal-Wan stage does) hits per prompt, also
+    inside SGLang's own conditioning-cache scope."""
+
+    class PerPromptStage(te.TextEncodingStage):
+        def encode_text(self, text, server_args, *args, **kwargs):
+            if isinstance(text, str) or len(text) <= 1:
+                return super().encode_text(text, server_args, *args, **kwargs)
+            return te._stack_rows([super(PerPromptStage, self).encode_text([t], server_args, *args, **kwargs) for t in text])
+
+    encoder = BatchVariantEncoder()
+    stage, args = make_stage([encoder], PerPromptStage), make_args()
+    plain = encode(stage, ["first", "switch"], args, "cpu")
+    cache = cache_bytes(1 << 20)
+    encoder.calls.clear()
+    with ConditioningCache(1 << 20).scope():
+        cached = encode(stage, ["first", "switch"], args, "cpu")
+        again = encode(stage, ["first", "switch", "first"], args, "cpu")
+    assert_bitwise(cached, plain)
+    assert_bitwise(again[0][0][:2], plain[0][0])
+    assert encoder.calls == [1, 1] and cache.stats()["hits"] == 3
