+    def begin_causal_kv_early_restore(self, batch: Req, server_args: ServerArgs) -> None:
+        """PROTOTYPE (branch ``reelcache-overlap-proto``): offer the backend this session request's restore when the
+        worker dispatches it, before text encoding and latent preparation.
+
+        The stage hands over its existing self-attention caches and its RoPE. The backend plans from the session's
+        archived geometry and starts a background restore into these caches. At ``begin_request`` it adopts the
+        restore only for the same request, head and cache objects; otherwise it discards it. Caches the request
+        reallocates are therefore never adopted. Best effort: never raises.
+        """
+        backend = self._causal_kv_backend
+        early = getattr(backend, "early_restore", None)
+        if early is None or getattr(batch, "is_warmup", False):
+            return
+        try:
+            session = validate_causal_kv_session(getattr(batch, "causal_kv_session", None))
