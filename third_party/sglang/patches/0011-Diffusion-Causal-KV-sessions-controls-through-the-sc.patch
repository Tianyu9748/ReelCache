+def _causal_kv_decode_window(batch: Req) -> tuple[torch.Tensor, int | None]:
+    """Latents to decode and how many trailing latent frames to keep.
+
+    A causal KV session request that restored history and asked for its new
+    chunks only (``--reelcache-enable``; the backend's ``decode`` plan in
+    ``batch.extra["causal_kv"]``) decodes from ``start_latent``: a few context
+    latents that warm the causal VAE decoder, then the new chunks. Otherwise
+    the whole ``batch.latents`` (``None``: keep every frame)."""
+    summary = batch.extra.get("causal_kv")
+    plan = summary.get("decode") if isinstance(summary, dict) else None
+    if not isinstance(plan, dict) or plan.get("output") != "new":
+        return batch.latents, None
+    start = int(plan["start_latent"])
+    latents = batch.latents[:, :, start:]
+    return latents, int(latents.shape[2]) - int(plan["context_latents"])
+
+
+def _keep_last_latent_frames(
+    frames: torch.Tensor, latents: torch.Tensor, keep: int
+) -> torch.Tensor:
+    """The frames of the last ``keep`` latent frames of a causal (Wan) VAE decode:
+    the first decoded latent yields one frame, each later one ``(F - 1) / (T - 1)``."""
+    total = int(latents.shape[2])
+    if keep >= total:
+        return frames
+    per_latent = (int(frames.shape[2]) - 1) // max(total - 1, 1)
+    return frames[:, :, -keep * per_latent :]
+
