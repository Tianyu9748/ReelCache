+#: ``out`` dtypes a float32 ``x`` may be rotated into: the float32 result rounded once, as ``.to(dtype)`` of the
+#: returned tensor would (round to nearest even).
+NARROWER_OUT_DTYPES = (torch.bfloat16, torch.float16)
+
+
+def check_rotary_out(x: torch.Tensor, out: torch.Tensor) -> None:
+    """``out`` of :func:`apply_rotary_embedding`: ``x``'s shape and device; ``x``'s dtype, or for a float32 ``x`` a
+    narrower float dtype (:data:`NARROWER_OUT_DTYPES`); a unit-stride last dimension; no memory shared with ``x``
+    (the kernel is autotuned, and autotuning re-runs it on the same pointers)."""
+    if not isinstance(out, torch.Tensor):
+        raise TypeError("out must be a tensor")
+    dtype_ok = out.dtype == x.dtype or (
+        x.dtype == torch.float32 and out.dtype in NARROWER_OUT_DTYPES
+    )
+    if out.shape != x.shape or not dtype_ok or out.device != x.device:
+        raise ValueError(
+            f"out must match x: shape {tuple(x.shape)}, dtype {x.dtype} (or narrower for float32), device "
+            f"{x.device} (got {tuple(out.shape)}, {out.dtype}, {out.device})"
+        )
+    if out.numel() and out.stride(-1) != 1:
+        raise ValueError("out must have a unit-stride last dimension")
+    if out.numel() and out.untyped_storage().data_ptr() == x.untyped_storage().data_ptr():
+        raise ValueError("out must not share memory with x")
+
+
