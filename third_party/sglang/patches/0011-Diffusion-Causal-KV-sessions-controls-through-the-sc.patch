+def test_decode_window_keeps_only_the_new_chunks():
+    latents = torch.arange(9.0).view(1, 1, 9, 1, 1).expand(1, 2, 9, 2, 2)
+    plain = SimpleNamespace(extra={}, latents=latents)
+    assert decoding._causal_kv_decode_window(plain)[1] is None
+    full = SimpleNamespace(
+        extra={"causal_kv": {"decode": {"output": "full"}}}, latents=latents
+    )
+    assert decoding._causal_kv_decode_window(full)[0] is latents
+    plan = {
+        "output": "new",
+        "start_latent": 4,
+        "context_latents": 2,
+        "first_new_latent": 6,
+        "exact": False,
+    }
+    window, keep = decoding._causal_kv_decode_window(
+        SimpleNamespace(extra={"causal_kv": {"decode": plan}}, latents=latents)
+    )
+    assert window.shape[2] == 5 and keep == 3 and float(window[0, 0, 0, 0, 0]) == 4.0
+    frames = torch.arange(1 + 4 * 4.0).view(
+        1, 1, 17, 1, 1
+    )  # 5 latents: 1 + 4 x 4 frames
+    kept = decoding._keep_last_latent_frames(frames, window, keep)
+    assert kept.flatten().tolist() == list(
+        range(5, 17)
+    )  # the last 3 latents' 12 frames
