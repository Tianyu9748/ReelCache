@@ -283,6 +283,51 @@ class GPUWorker(GPUWorkerPostTrainingMixin):
         self._auto_residency_warmup_records: list[WarmupMemoryRecord] = []
         self._update_lora_metrics()
 
+    # --- causal KV session controls (--reelcache-enable) -------------------------------
+
+    def _causal_kv_control_call(self, method: str, op: str, args: dict) -> Any:
+        backend = self.causal_kv_backend
+        control = None if backend is None else getattr(backend, method, None)
+        if control is None:
+            return OutputBatch(
+                error="session controls require a server started with --reelcache-enable",
+                output={
+                    "error": {
+                        "code": "unsupported",
+                        "status": 404,
+                        "message": "session controls require --reelcache-enable",
+                    }
+                },
+            )
+        try:
+            return control(op, args)
+        except Exception as exc:  # noqa: BLE001 - typed control errors become replies
+            to_dict = getattr(exc, "to_dict", None)
+            error = (
+                to_dict()
+                if callable(to_dict)
+                else {"code": "internal", "status": 500, "message": repr(exc)}
+            )
+            return OutputBatch(error=error.get("message", repr(exc)), output={"error": error})
+
+    def causal_kv_session_control(self, op: str, args: dict) -> OutputBatch:
+        """A session control between requests (``CausalKVSessionControlReq``)."""
+        result = self._causal_kv_control_call("control", op, args)
+        return result if isinstance(result, OutputBatch) else OutputBatch(output=result)
+
+    def causal_kv_session_inflight(self, op: str, args: dict) -> OutputBatch | None:
+        """A session control received while a request runs (scheduler boundary poll).
+
+        None: run it after the running request (it may block or change the
+        running session); else the reply now (``output["deferred"]`` set:
+        reply after the running request, once the pause is durable)."""
+        if getattr(self.causal_kv_backend, "inflight_control", None) is None:
+            return None
+        result = self._causal_kv_control_call("inflight_control", op, args)
+        if result is None or isinstance(result, OutputBatch):
+            return result
+        return OutputBatch(output=result)
