+    ids_first = stage._causal_kv_block_conditioning(first, None, [8] * 4)
+    ids_switched = stage._causal_kv_block_conditioning(switched, None, [8] * 4)
+    assert ids_first[:2] == ids_switched[:2] and ids_first[2:] != ids_switched[2:]
+    assert ids_switched[2].startswith("shot1:cut:") and ids_switched[3].startswith(
+        "shot1:cont:"
+    )
+    plain = SimpleNamespace(extra={}, sampling_params=None)
+    assert stage._causal_kv_block_conditioning(plain, None, [8] * 4) is None
+    with pytest.raises(ValueError):
+        stage._causal_kv_block_conditioning(first, None, [8] * 3)
