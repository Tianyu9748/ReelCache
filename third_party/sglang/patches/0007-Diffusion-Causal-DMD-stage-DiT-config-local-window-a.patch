+# SPDX-License-Identifier: Apache-2.0
+"""Causal DMD stage: DiT-config local window and request-scoped cache geometry."""
+
+import inspect
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.multimodal_gen.runtime.layers.kvcache.causal_attention_cache import (
+    CausalSelfAttentionKVCache,
+)
+from sglang.multimodal_gen.runtime.pipelines_core.stages import denoising
+from sglang.multimodal_gen.runtime.pipelines_core.stages.causal_denoising import (
+    CausalDMDDenoisingStage,
+)
+
+
+def _transformer(**config):
+    values = dict(num_layers=2, num_frames_per_block=3, sliding_window_num_frames=21, sink_size=1)
+    values.update(config)
+    return SimpleNamespace(config=SimpleNamespace(**values))
+
+
+@pytest.fixture
+def light_init(monkeypatch):
+    """Skip DenoisingStage.__init__ (it needs global server args); keep the causal stage's own init."""
+
+    def init(self, transformer, scheduler, *args, **kwargs):
+        self.transformer, self.scheduler = transformer, scheduler
+
+    monkeypatch.setattr(denoising.DenoisingStage, "__init__", init)
+
+
+def _cache(size, sink, layers=2):
+    return [
+        CausalSelfAttentionKVCache(
+            k=torch.zeros(1, size, 1, 1),
+            v=torch.zeros(1, size, 1, 1),
+            global_end_index=torch.zeros(1, dtype=torch.long),
+            local_end_index=torch.zeros(1, dtype=torch.long),
+            cache_size=size,
+            sink_tokens=sink,
+        )
+        for _ in range(layers)
+    ]
+
+
+def test_local_window_comes_from_the_dit_config(light_init):
+    stage = CausalDMDDenoisingStage(_transformer(local_attn_size=32), None)
+    stage.num_token_per_frame = 10
+    assert stage.local_attn_size == 32
+    assert stage._get_causal_kv_cache_size() == 320
+    default = CausalDMDDenoisingStage(_transformer(), None)  # no local_attn_size: sliding window
+    default.num_token_per_frame = 10
+    assert default.local_attn_size == -1 and default._get_causal_kv_cache_size() == 210
+    stage._causal_kv_cache_frames_override = 12  # an explicit realtime KV-buffer override wins
+    assert stage._get_causal_kv_cache_size() == 120
+    assert 'getattr(self.transformer.config, "local_attn_size", -1)' in inspect.getsource(CausalDMDDenoisingStage.__init__)
+
+
+def test_stage_caches_follow_each_requests_geometry(light_init):
+    stage = CausalDMDDenoisingStage(_transformer(), None)
+    batch = SimpleNamespace(extra={})
+    stage.num_token_per_frame = 10
+    caches = _cache(210, 10)
+    assert stage._cache_needs_reinit_for_batch(None, batch)
+    assert not stage._cache_needs_reinit_for_batch(caches, batch)
+    assert stage._causal_kv_cache_kwargs_for_batch(batch) is None
+    stage.num_token_per_frame = 20  # another resolution: the stage caches no longer fit
+    assert stage._cache_needs_reinit_for_batch(caches, batch)
+    stage.num_token_per_frame = 10
+    assert stage._cache_needs_reinit_for_batch(_cache(210, 0), batch)  # sink geometry differs
+    assert stage._cache_needs_reinit_for_batch(_cache(210, 10, layers=3), batch)
+
+    class FullHistoryStage(CausalDMDDenoisingStage):
+        def _causal_kv_cache_size_for_batch(self, batch):
+            return batch.total_frames * self.num_token_per_frame
+
+    full = FullHistoryStage(_transformer(), None)
+    full.num_token_per_frame = 10
+    request = SimpleNamespace(extra={}, total_frames=36)
+    assert full._causal_kv_cache_kwargs_for_batch(request) == {"kv_cache_size": 360}
+    assert full._cache_needs_reinit_for_batch(caches, request)
+    assert not full._cache_needs_reinit_for_batch(_cache(360, 10), request)
+    source = inspect.getsource(CausalDMDDenoisingStage.forward)
+    assert "_cache_needs_reinit_for_batch(self.causal_kv_cache, batch)" in source
