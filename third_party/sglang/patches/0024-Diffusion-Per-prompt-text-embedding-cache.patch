+# SPDX-License-Identifier: Apache-2.0
+"""Text-embedding cache (workload-v2): per-prompt host LRU of ``TextEncodingStage.encode_text`` outputs.
+
+Off unless ``SGLANG_WL_EMBED_CACHE_BYTES`` > 0 (then ``encode_text`` is the plain call). A hit returns the stored
+output bitwise (dtype and device kept); a prompt list is served per prompt, so the result never depends on the
+cache state (hits == misses) -- the encoder here is batch-variant on purpose, as umt5 is. Eviction is LRU by bytes;
+the key changes with every encoder and call setting; hits and misses are counted and timed as ``text_encode`` /
+``text_encode_cached`` spans of the request's workload timer.
+"""
+
+import hashlib
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+import torch
+from transformers import BatchEncoding
+
+from sglang.multimodal_gen.configs.models.encoders import BaseEncoderOutput
+from sglang.multimodal_gen.configs.sample.longlive2 import LongLive2SamplingParams
+from sglang.multimodal_gen.configs.sample.sampling_params import SamplingParams
+from sglang.multimodal_gen.runtime.cache.conditioning import (
+    ConditioningCache,
+    invalidate_conditioning_caches,
+)
+from sglang.multimodal_gen.runtime.models.encoders.base import TextEncoder
+from sglang.multimodal_gen.runtime.pipelines_core.schedule_batch import Req
+from sglang.multimodal_gen.runtime.pipelines_core.stages import text_encoding as te
+from sglang.multimodal_gen.runtime.pipelines_core.stages.causal_denoising import (
+    CAUSAL_BLOCK_PROMPTS_KEY,
+)
+from sglang.multimodal_gen.runtime.pipelines_core.stages.model_specific_stages.longlive2 import (
+    LongLive2TextEncodingStage,
+)
+from sglang.multimodal_gen.runtime.utils import workload_timer as wt
+
+_GLOBAL_ARGS_PATCH = "sglang.multimodal_gen.runtime.pipelines_core.stages.base.get_global_server_args"
+DEVICES = ["cpu"] + (["cuda"] if torch.cuda.is_available() else [])
+TOKENS = 4
+
+
+class BatchVariantEncoder(TextEncoder):
+    """Toy encoder whose rows depend on the batch size (umt5 is not batch-invariant either)."""
+
+    uses_sglang_forward_context = False
+
+    def __init__(self, dtype=torch.float32):
+        torch.nn.Module.__init__(self)
+        self.weight = torch.nn.Parameter(torch.ones((), dtype=dtype))
+        self.calls = []  # batch size of every forward
+
+    def forward(self, input_ids, **kwargs):
+        self.calls.append(int(input_ids.shape[0]))
+        base = input_ids[..., None].to(self.weight.dtype) * self.weight
+        jitter = 1e-3 * input_ids.shape[0]
+        states = tuple(base.repeat(1, 1, 3) / 7 + layer + jitter for layer in range(6))
+        return BaseEncoderOutput(
+            last_hidden_state=states[-1],
+            hidden_states=states,
+            pooler_output=states[-1][:, 0].clone(),
+        )
+
+
+def _postprocess(output, text_inputs, return_attention_mask=False):
+    return output.hidden_states[3]
+
+
+def _postprocess_other(output, text_inputs, return_attention_mask=False):
+    return output.hidden_states[4]
+
+
+def _tokenize(texts, _tokenizer, kwargs):
+    length = int(kwargs.get("max_length") or TOKENS)
+    rows = []
+    for text in texts:
+        digest = hashlib.sha256(text.encode()).digest()
+        rows.append([len(text)] + [digest[i] for i in range(length - 1)])
+    return BatchEncoding(
+        {
+            "input_ids": torch.tensor(rows),
+            "attention_mask": torch.ones((len(texts), length), dtype=torch.long),
+        }
+    )
+
+
+def make_config(encoders=1, *, tokenizer_kwargs=None, postprocess=_postprocess):
+    return SimpleNamespace(
+        text_encoder_configs=[
+            SimpleNamespace(tokenizer_kwargs=dict(tokenizer_kwargs or {})) for _ in range(encoders)
+        ],
+        preprocess_text_funcs=[None] * encoders,
+        postprocess_text_funcs=[postprocess] * encoders,
+        text_encoder_extra_args=[],
+        is_flux_v1=lambda: False,
+        tokenize_prompt=_tokenize,
+        get_text_encoder_attention_mask=lambda inputs, _: inputs["attention_mask"],
+        get_text_encoder_pooler_output=lambda outputs, _: outputs.pooler_output,
+        build_text_conditioning_mask=lambda inputs, mask, embeds, _: mask.bool(),
+        seq_lens_from_text_conditioning_mask=lambda mask: mask.sum(-1).tolist(),
+        vae_config=SimpleNamespace(use_temporal_scaling_frames=False),
+        dit_config=SimpleNamespace(arch_config=SimpleNamespace(num_frames_per_block=1)),
+    )
+
+
+def make_args(config=None, **kwargs):
+    defaults = {
+        "pipeline_config": config or make_config(),
+        "model_path": "/models/longlive2/snapshots/rev-a",
+        "model_paths": {"text_encoder": "/models/longlive2/snapshots/rev-a/text_encoder"},
+    }
+    defaults.update(kwargs)
+    return SimpleNamespace(**defaults)
+
+
+def make_stage(encoders, stage_type=te.TextEncodingStage):
+    with patch(_GLOBAL_ARGS_PATCH, return_value=MagicMock()):
+        stage = stage_type(text_encoders=list(encoders), tokenizers=[object() for _ in encoders])
+    stage._begin_text_encoder_use = MagicMock()
+    stage._text_encode_dp_group = MagicMock(return_value=None)
