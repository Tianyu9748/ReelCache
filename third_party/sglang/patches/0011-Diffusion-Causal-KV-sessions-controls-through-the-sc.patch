+class _Run:
+    def __init__(self):
+        self.events = []
+
+    def stream_of(self, kv_cache):
+        return "cond"
+
+    def begin_clean_forward(self, capture):
+        self.events.append(("begin", capture.chunk.index))
+
+    def capture_layer(self, capture, layer_index, key, value, freqs_cis):
+        self.events.append(("layer", layer_index))
+
+    def end_clean_forward(self, capture):
+        self.events.append(("end", capture.chunk.index))
+
+
+def test_capture_scope_announces_the_clean_forward_start():
+    run = _Run()
+    chunk = seam.CausalKVChunk(2, 6, 3, 0, 10, 6, False, 0)
+    with seam.causal_kv_capture_scope(run, chunk, "pos") as scope:
+        scope.capture_layer(0, torch.zeros(1), torch.zeros(1), (None, None))
+    assert run.events == [("begin", 2), ("layer", 0), ("end", 2)]
