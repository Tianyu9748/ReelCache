From: Tianyu9748 <54686548+Tianyu9748@users.noreply.github.com>
Date: Fri, 16 Oct 2026 00:53:13 -0400
Subject: [PATCH 12/26] [Diffusion] LongLive2: multi-shot fields over HTTP;
 per-block session conditioning

* LongLive2SamplingParams declares its native multi-shot fields (shot_prompts,
  shot_durations, chunks_per_shot, scene_cut_prefix, multi_shot_sink,
  multi_shot_rope_offset) as /v1/videos extras (they were dropped before).
* Multi-shot requests give the causal KV backend one conditioning id per
  block (shot index, scene cut, block prompt) and leave the timeline fields
  out of the request identity, so a session continues under a new shot (the
  native prompt change at a chunk boundary) while its restored blocks keep
  their own shots. Single-prompt requests keep the whole-request identity.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 .../configs/sample/longlive2.py               | 14 ++++++
 .../stages/model_specific_stages/longlive2.py | 43 +++++++++++++++++++
 2 files changed, 57 insertions(+)

diff --git a/python/sglang/multimodal_gen/configs/sample/longlive2.py b/python/sglang/multimodal_gen/configs/sample/longlive2.py
index c0dee0b40f..a2734ad3ac 100644
--- a/python/sglang/multimodal_gen/configs/sample/longlive2.py
+++ b/python/sglang/multimodal_gen/configs/sample/longlive2.py
@@ -36,6 +36,20 @@ class LongLive2SamplingParams(Wan2_2_TI2V_5B_SamplingParam):
         ]
     )
 
+    @classmethod
+    def video_request_extra_fields(cls) -> frozenset[str]:
+        # LongLive 2.0's native multi-shot fields are reachable through /v1/videos.
+        return super().video_request_extra_fields() | frozenset(
+            {
+                "shot_prompts",
+                "shot_durations",
+                "chunks_per_shot",
+                "scene_cut_prefix",
+                "multi_shot_sink",
+                "multi_shot_rope_offset",
+            }
+        )
+
     def _validate(self):
         super()._validate()
 
diff --git a/python/sglang/multimodal_gen/runtime/pipelines_core/stages/model_specific_stages/longlive2.py b/python/sglang/multimodal_gen/runtime/pipelines_core/stages/model_specific_stages/longlive2.py
index 0333edbab2..943c2e3bbf 100644
--- a/python/sglang/multimodal_gen/runtime/pipelines_core/stages/model_specific_stages/longlive2.py
+++ b/python/sglang/multimodal_gen/runtime/pipelines_core/stages/model_specific_stages/longlive2.py
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: Apache-2.0
+import hashlib
 from collections.abc import Callable
 from typing import Any
 
@@ -242,6 +243,48 @@ class LongLive2CausalDenoisingStage(CausalDMDDenoisingStage):
             return 0
         return self._get_causal_sink_tokens()
 
+    # --- optional causal KV archive backend: multi-shot timelines ----------------
+
+    # Request fields whose effect the per-block conditioning carries in multi-shot
+    # mode (``shot_prompts``): the block prompts (scene-cut prefix included) and
+    # the shot boundaries. ``prompt`` is unused there (block prompts replace it).
+    _CAUSAL_KV_SHOT_FIELDS = (
+        "prompt",
+        "shot_prompts",
+        "shot_durations",
+        "chunks_per_shot",
+        "scene_cut_prefix",
+    )
+
+    def _causal_kv_conditioning(self, batch: Req, server_args: ServerArgs) -> dict:
+        identity = super()._causal_kv_conditioning(batch, server_args)
+        if batch.extra.get(CAUSAL_BLOCK_PROMPTS_KEY) is not None:
+            for name in self._CAUSAL_KV_SHOT_FIELDS:
+                identity.pop(name, None)
+            identity["multi_shot_timeline"] = "block_conditioning"
+        return identity
+
+    def _causal_kv_block_conditioning(
+        self, batch: Req, server_args: ServerArgs, block_sizes: list[int]
+    ) -> tuple[str, ...] | None:
+        """Multi-shot mode: one id per block (shot index, scene cut, block prompt),
+        so a session can continue under a new shot (a native prompt change at a
+        chunk boundary) while its restored blocks keep their own shots. Single-
+        prompt requests keep the whole-request identity (None)."""
+        prompts = batch.extra.get(CAUSAL_BLOCK_PROMPTS_KEY)
+        if prompts is None:
+            return None
+        if len(prompts) != len(block_sizes):
+            raise ValueError(
+                f"{len(prompts)} block prompts for {len(block_sizes)} causal blocks"
+            )
+        identities = []
+        for index, prompt in enumerate(prompts):
+            digest = hashlib.sha256(str(prompt).encode("utf-8")).hexdigest()[:32]
+            cut = "cut" if self._is_scene_cut(batch, index) else "cont"
+            identities.append(f"shot{self._shot_index(batch, index)}:{cut}:{digest}")
+        return tuple(identities)
+
     def _is_scene_cut(self, batch: Req, block_index: int) -> bool:
         if not self._multi_shot_sink_enabled(batch):
             return False
