+def test_lru_eviction_by_bytes():
+    def output(value):
+        return ([torch.full((1, 4, 8), float(value))], [torch.ones((1, 4), dtype=torch.long)], [[4]])
+
+    size = te._encoded_bytes(output(0))
+    assert size == 4 * 8 * 4 + 4 * 8
+    cache = te.TextEmbeddingCache(int(2.5 * size))
+    assert cache.store("a", output(1)) and cache.store("b", output(2))
+    assert cache.lookup("a") is not None  # a is now the most recently used
+    assert cache.store("c", output(3))
+    assert cache.keys() == ["a", "c"] and cache.evictions == 1 and cache.bytes == 2 * size
+    assert cache.lookup("b") is None
+    assert_bitwise(cache.lookup("a").restore(), output(1))
+    assert not cache.store("huge", ([torch.zeros(1, 64, 64)],))  # larger than the cache: never kept
+    assert cache.keys() == ["c", "a"] and cache.bytes <= cache.max_bytes
+    assert cache.store("a", output(5)) and cache.bytes == 2 * size  # replacing keeps the byte count exact
+    assert_bitwise(cache.lookup("a").restore(), output(5))
+    stats = cache.stats()
+    assert (stats["hits"], stats["misses"], stats["stores"], stats["evictions"], stats["bypasses"]) == (3, 1, 4, 1, 1)
+    cache.clear()
+    assert len(cache) == 0 and cache.bytes == 0
