--- /dev/null
+++ b/python/sglang/multimodal_gen/test/unit/test_causal_kv_overlap.py
@@ -0,0 +1,173 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Layer-overlapped restore seam (PROTOTYPE, branch ``reelcache-overlap-proto``): ``restore_pending``, the session
+handle's ``overlap_restore`` and the stage's early-restore offer."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.multimodal_gen.runtime.layers.kvcache.causal_attention_cache import (
+    CausalSelfAttentionKVCache,
+)
+from sglang.multimodal_gen.runtime.layers.kvcache.causal_kv_backend import (
+    OVERLAP_RESTORE_MODES,
+    validate_causal_kv_session,
+)
+from sglang.multimodal_gen.runtime.pipelines_core.stages.causal_denoising import (
+    CausalDMDDenoisingStage,
+)
+
+TPF, CHUNK_FRAMES, CACHE_FRAMES = 2, 3, 12
+CHUNK = CHUNK_FRAMES * TPF
+
+
+def _cache(*, sink_frames=3, cache_frames=CACHE_FRAMES):
+    shape = [1, cache_frames * TPF, 2, 4]
+    return CausalSelfAttentionKVCache(
+        k=torch.zeros(shape),
+        v=torch.zeros(shape),
+        global_end_index=torch.zeros(1, dtype=torch.long),
+        local_end_index=torch.zeros(1, dtype=torch.long),
+        cache_size=cache_frames * TPF,
+        sink_tokens=sink_frames * TPF,
+    )
+
+
+class _Pending:
+    """A background restore that writes the layer's history only when the consumer waits for it."""
+
+    def __init__(self, cache, fill):
+        self.cache, self.fill, self.calls = cache, fill, 0
+
+    def wait(self):
+        self.calls += 1
+        self.fill(self.cache)
+
+
+def _restored(chunks):
+    """A cache with ``chunks`` installed (cursors only, as a background restore leaves it) and the full layout."""
+    cache = _cache()
+    layout = cache.replay_layout([(index * CHUNK, CHUNK, False) for index in range(chunks)])
+    cache.install_restored_history(layout, lambda span, k, v: None)
+    return cache, layout
+
+
+def _fill(layout):
+    def fill(cache):
+        for span in layout.live:
+            positions = torch.arange(span.global_start, span.global_start + span.length, dtype=torch.float32)
+            cache.k[0, span.local_start : span.local_end] = positions.view(-1, 1, 1) + 1.0
+            cache.v[0, span.local_start : span.local_end] = -(positions.view(-1, 1, 1) + 1.0)
+
+    return fill
+
+
+def test_the_first_access_waits_once_before_reading_or_writing():
+    cache, layout = _restored(2)
+    pending = cache.restore_pending = _Pending(cache, _fill(layout))
+    assert not cache.can_direct_current_attention(CHUNK)  # never bypass a pending restore
+    key = torch.full((1, CHUNK, 2, 4), 100.0)
+    view = cache.update_and_get_attention_kv(key=key, value=-key, current_chunk_start=2 * CHUNK)
+    assert pending.calls == 1 and cache.restore_pending is None
+    # the restored history (written by the wait) is visible together with the new chunk
+    assert torch.equal(view.k[0, : 2 * CHUNK, 0, 0], torch.arange(2 * CHUNK, dtype=torch.float32) + 1.0)
+    assert torch.equal(view.k[0, 2 * CHUNK :, 0, 0], torch.full((CHUNK,), 100.0))
+    cache.update_and_get_attention_kv(key=key, value=-key, current_chunk_start=2 * CHUNK)
+    assert pending.calls == 1  # one-shot
+
+
+def test_the_wait_precedes_the_eviction_roll():
+    """A full window rolls the restored tokens inside the buffer on the next append: they must be written first."""
+    chunks = CACHE_FRAMES // CHUNK_FRAMES  # the buffer is full
+    cache, layout = _restored(chunks)
+    cache.restore_pending = _Pending(cache, _fill(layout))
+    key = torch.zeros(1, CHUNK, 2, 4)
+    cache.update_and_get_attention_kv(key=key, value=key, current_chunk_start=chunks * CHUNK)
+    reference, ref_layout = _restored(chunks)
+    _fill(ref_layout)(reference)
+    reference.update_and_get_attention_kv(key=key, value=key, current_chunk_start=chunks * CHUNK)
+    assert torch.equal(cache.k, reference.k) and torch.equal(cache.v, reference.v)
+    sink = cache.sink_tokens
+    assert torch.equal(cache.k[0, sink : sink + CHUNK, 0, 0], torch.arange(sink + CHUNK, sink + 2 * CHUNK,
+                                                                         dtype=torch.float32) + 1.0)
+
+
+def test_a_failed_restore_raises_at_the_access_and_writes_nothing():
+    cache, _ = _restored(1)
+
+    class Failed:
+        def wait(self):
+            raise RuntimeError("integrity")
+
+    cache.restore_pending = Failed()
+    before = cache.k.clone()
+    with pytest.raises(RuntimeError, match="integrity"):
+        cache.update_and_get_attention_kv(key=torch.ones(1, CHUNK, 2, 4), value=torch.ones(1, CHUNK, 2, 4),
+                                          current_chunk_start=CHUNK)
+    assert torch.equal(cache.k, before) and cache.restore_pending is None
+
+
+def test_a_cache_without_a_pending_restore_is_unchanged():
+    cache = _cache()
+    assert cache.restore_pending is None
+    view = cache.update_and_get_attention_kv(key=torch.ones(1, CHUNK, 2, 4), value=torch.ones(1, CHUNK, 2, 4),
+                                             current_chunk_start=0)
+    assert view.visible_global_end == CHUNK
+    probe = cache._position_shadow()
+    assert probe.restore_pending is None
+
+
+def test_the_session_handle_selects_the_overlap_mode():
+    assert OVERLAP_RESTORE_MODES == ("off", "first_forward", "early")
+    for mode in OVERLAP_RESTORE_MODES:
+        handle = validate_causal_kv_session({"session_id": "s", "action": "resume", "overlap_restore": mode})
+        assert handle["overlap_restore"] == mode
+    assert "overlap_restore" not in validate_causal_kv_session({"session_id": "s", "action": "resume"})
+    with pytest.raises(ValueError, match="overlap_restore"):
+        validate_causal_kv_session({"session_id": "s", "action": "resume", "overlap_restore": "always"})
+
+
+class _Backend:
+    def __init__(self, fail=False):
+        self.calls, self.fail = [], fail
+
+    def early_restore(self, **kwargs):
+        if self.fail:
+            raise RuntimeError("planning failed")
+        self.calls.append(kwargs)
+
+
+def _stage(backend, caches):
+    stage = object.__new__(CausalDMDDenoisingStage)
+    stage._causal_kv_backend = backend
+    stage.causal_kv_cache = caches
+    stage.transformer = SimpleNamespace(causal_rotary_cos_sin=lambda *a, **k: None,
+                                        causal_rotate_key=lambda k, cos, sin: k)
+    stage._causal_sequence_shard_enabled = lambda batch: False
+    return stage
+
+
+def _batch(session, **extra):
+    return SimpleNamespace(request_id="r1", causal_kv_session=session, is_warmup=False, image_latent=None, **extra)
+
+
+def test_the_stage_offers_session_restores_early_with_its_caches():
+    caches = [_cache(), _cache()]
+    backend = _Backend()
+    stage = _stage(backend, caches)
+    stage.begin_causal_kv_early_restore(_batch({"session_id": "f", "action": "fork", "from_session": "L",
+                                                "checkpoint": 2, "overlap_restore": "early"}), None)
+    [call] = backend.calls
+    assert call["request_id"] == "r1" and call["session"]["overlap_restore"] == "early"
+    assert call["caches"]["cond"] is caches and call["device"] == caches[0].k.device
+    for session in (None, {"session_id": "g", "action": "generate"}):
+        stage.begin_causal_kv_early_restore(_batch(session), None)
+    stage.begin_causal_kv_early_restore(_batch({"session_id": "s", "action": "resume"}, ), None)
+    assert len(backend.calls) == 2  # generate and plain requests are never offered
+    _stage(backend, None).begin_causal_kv_early_restore(_batch({"session_id": "s", "action": "resume"}), None)
+    assert len(backend.calls) == 2  # no stage caches yet (first request)
+    _stage(_Backend(fail=True), caches).begin_causal_kv_early_restore(
+        _batch({"session_id": "s", "action": "resume"}), None)  # a failing backend never fails the request
+    _stage(SimpleNamespace(), caches).begin_causal_kv_early_restore(
+        _batch({"session_id": "s", "action": "resume"}), None)  # a backend without the seam: nothing
-- 
