diff --git a/python/sglang/multimodal_gen/test/unit/test_rotary_out.py b/python/sglang/multimodal_gen/test/unit/test_rotary_out.py
new file mode 100644
index 0000000000..659fa654a5
--- /dev/null
+++ b/python/sglang/multimodal_gen/test/unit/test_rotary_out.py
@@ -0,0 +1,143 @@
+"""``out=`` of the diffusion rotary embedding (Step 5c's F6 proposal: restored KV written in place).
+
+``apply_rotary_embedding`` / ``_apply_rotary_emb`` / ``causal_wan_rotate_key`` take an optional ``out`` of ``x``'s
+shape and dtype, e.g. a slot of a ``[B, T, H, D]`` KV cache, write the rotation there and return it. The kernel and its
+arithmetic are unchanged, so the written bits are those of the returned tensor without ``out``; a float32 ``x`` may
+go into a bfloat16 / float16 ``out`` (rounded once, as ``.to(dtype)``). Nothing outside the slot is touched. Invalid
+outputs raise instead of being resized or written partially.
+
+Without CUDA the torch fallback runs; with CUDA the autotuned Triton kernel, including a first call that autotunes
+into ``out``, and the Wan / LongLive 2.0 head geometries with multi-shot RoPE offsets.
+"""
+
+import pytest
+import torch
+
+from sglang.kernels.ops.diffusion.rope.rotary_triton import (
+    apply_rotary_embedding,
+    check_rotary_out,
+)
+from sglang.multimodal_gen.runtime.layers.rotary_embedding import _apply_rotary_emb
+
+# SGLang binds the rotation per platform (the Triton kernel on CUDA, the torch fallback without it), not per tensor
+# device: run the platform's own implementation.
+DEVICES = ["cuda"] if torch.cuda.is_available() else ["cpu"]
+
+
+def tables(tokens, head_size, *, start_frame=0.0, tokens_per_frame=16, device="cpu"):
+    """Per-token cos / sin (float32) at positions from ``start_frame`` (multi-shot: start + shot * offset)."""
+    positions = (
+        torch.arange(tokens, dtype=torch.float64) // tokens_per_frame + start_frame
+    )
+    inverse = 1.0 / (
+        10000.0 ** (torch.arange(0, head_size, 2, dtype=torch.float64) / head_size)
+    )
+    angles = positions[:, None] * inverse[None, :]
+    return angles.cos().float().to(device), angles.sin().float().to(device)
+
+
+def bits(tensor):
+    return tensor.view(torch.int16 if tensor.element_size() == 2 else torch.int32)
+
+
+def cache_slot(tokens, heads, head_size, dtype, device, *, slot_start=7, capacity=None):
+    capacity = capacity or tokens + 2 * slot_start
+    cache = torch.full(
+        (1, capacity, heads, head_size), float("nan"), dtype=dtype, device=device
+    )
+    return cache, cache[:, slot_start : slot_start + tokens]
+
+
+@pytest.mark.parametrize("device", DEVICES)
+@pytest.mark.parametrize(
+    "tokens,heads,head_size,dtype",
+    [
+        (4680, 12, 128, torch.bfloat16),  # CausVid / RAVEN / LongLive 1.0 chunk
+        (1337, 24, 128, torch.bfloat16),  # LongLive 2.0 heads, odd token count
+        (64, 5, 64, torch.float32),  # an uncached autotune key on CUDA
+    ],
+)
+def test_out_writes_the_returned_bits_into_a_cache_slot(device, tokens, heads, head_size, dtype):
+    generator = torch.Generator().manual_seed(tokens)
+    x = torch.randn(1, tokens, heads, head_size, generator=generator).to(dtype).to(device)
+    for shot in range(3):  # LongLive 2.0: rope_start_frame = start_frame + shot_index * multi_shot_rope_offset
+        cos, sin = tables(tokens, head_size, start_frame=4.0 + shot * 10.0, device=device)
+        expected = apply_rotary_embedding(x, cos, sin)
+        cache, slot = cache_slot(tokens, heads, head_size, dtype, device)
+        before = bits(cache).clone()
+        returned = apply_rotary_embedding(x, cos, sin, out=slot)
+        assert returned.data_ptr() == slot.data_ptr()
+        assert torch.equal(bits(slot), bits(expected))
+        outside = torch.ones(cache.shape[1], dtype=torch.bool)
+        outside[7 : 7 + tokens] = False
+        assert torch.equal(bits(cache)[:, outside.to(device)], before[:, outside.to(device)])
+
+
+@pytest.mark.parametrize("device", DEVICES)
+def test_the_wan_key_rotation_and_both_rope_styles_take_out(device):
+    x = torch.randn(1, 96, 4, 64, dtype=torch.bfloat16).to(device)
+    cos, sin = tables(96, 64, device=device)
+    for neox in (False, True):
+        expected = _apply_rotary_emb(x, cos, sin, is_neox_style=neox)
+        _, slot = cache_slot(96, 4, 64, torch.bfloat16, device)
+        assert _apply_rotary_emb(x, cos, sin, is_neox_style=neox, out=slot) is slot
+        assert torch.equal(bits(slot), bits(expected))
+    try:
+        from sglang.multimodal_gen.runtime.models.dits.causal_wanvideo import (
+            causal_wan_rotate_key,
+        )
+    except Exception as exc:  # noqa: BLE001 - the model module needs the full runtime
+        pytest.skip(f"causal_wanvideo not importable here: {exc}")
+    expected = causal_wan_rotate_key(x, cos, sin)
+    _, slot = cache_slot(96, 4, 64, torch.bfloat16, device)
+    assert causal_wan_rotate_key(x, cos, sin, out=slot) is slot
+    assert torch.equal(bits(slot), bits(expected))
+
+
+@pytest.mark.parametrize("device", DEVICES)
+@pytest.mark.parametrize("narrow", [torch.bfloat16, torch.float16])
+def test_a_float32_key_rotates_into_a_narrower_cache_rounded_once(device, narrow):
+    """RAVEN rotates float32 keys and stores them bfloat16 (``rotate(k).type_as(v)``): the narrower ``out`` gets
+    exactly those bits; a wider ``out`` than ``x`` is refused (it would skip the rounding to ``x``'s dtype)."""
+    generator = torch.Generator().manual_seed(5)
+    x = (torch.randn(1, 777, 12, 128, generator=generator) * 3).to(device)
+    cos, sin = tables(777, 128, start_frame=21.0, device=device)
+    expected = apply_rotary_embedding(x, cos, sin).to(narrow)
+    cache, slot = cache_slot(777, 12, 128, narrow, device)
+    assert apply_rotary_embedding(x, cos, sin, out=slot) is slot
+    assert torch.equal(bits(slot), bits(expected))
+    assert torch.equal(
+        bits(_apply_rotary_emb(x, cos, sin, is_neox_style=False, out=torch.empty_like(slot))), bits(expected)
+    )
+    with pytest.raises(ValueError):
+        apply_rotary_embedding(x.to(narrow), cos, sin, out=torch.empty_like(x))
+
+
+@pytest.mark.parametrize("device", DEVICES)
+def test_three_dimensional_inputs_take_out(device):
+    x = torch.randn(200, 3, 32, dtype=torch.bfloat16).to(device)
+    cos, sin = tables(200, 32, device=device)
+    expected = apply_rotary_embedding(x, cos, sin)
+    cache = torch.zeros(300, 3, 32, dtype=torch.bfloat16, device=device)
+    assert torch.equal(bits(apply_rotary_embedding(x, cos, sin, out=cache[50:250])), bits(expected))
+    assert not cache[:50].any() and not cache[250:].any()
+
+
+@pytest.mark.parametrize("device", DEVICES)
+def test_invalid_outputs_raise_and_write_nothing(device):
+    x = torch.randn(1, 32, 2, 16, dtype=torch.bfloat16).to(device)
+    cos, sin = tables(32, 16, device=device)
+    cases = [
+        torch.zeros(1, 31, 2, 16, dtype=torch.bfloat16, device=device),  # shape
+        torch.zeros(1, 32, 2, 16, dtype=torch.float32, device=device),  # dtype
+        torch.zeros(1, 32, 16, 2, dtype=torch.bfloat16, device=device).transpose(2, 3),  # last stride
+        x,  # the input itself
+        x.view(1, 32, 2, 16)[:, :, :, :],  # a view of the input
+    ]
+    for out in cases:
+        snapshot = out.clone()
+        with pytest.raises(ValueError):
+            apply_rotary_embedding(x, cos, sin, out=out)
+        assert torch.equal(bits(out.contiguous()), bits(snapshot.contiguous()))
+    with pytest.raises(TypeError):
+        check_rotary_out(x, "not a tensor")
