+        self.attn2 = CausalWanT2VCrossAttention(
             dim,
             num_heads,
             qk_norm=qk_norm,
diff --git a/python/sglang/multimodal_gen/test/unit/test_causal_wan_crossattn_cache.py b/python/sglang/multimodal_gen/test/unit/test_causal_wan_crossattn_cache.py
new file mode 100644
index 0000000000..d3c61dc6c0
--- /dev/null
+++ b/python/sglang/multimodal_gen/test/unit/test_causal_wan_crossattn_cache.py
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Stock causal-Wan cross-attention honors the per-block ``crossattn_cache`` (e00930c: TypeError)."""
+
+import inspect
+
+import torch
+import torch.nn as nn
+
+from sglang.multimodal_gen.runtime.layers.kvcache.causal_attention_cache import (
+    CrossAttentionKVCache,
+)
+from sglang.multimodal_gen.runtime.models.dits import causal_wanvideo
+from sglang.multimodal_gen.runtime.models.dits.causal_wanvideo import (
+    CausalWanT2VCrossAttention,
+)
+from sglang.multimodal_gen.runtime.models.dits.wanvideo import WanT2VCrossAttention
+
+HEADS, DIM, CONTEXT, TOKENS = 2, 4, 5, 6
+CHANNELS = HEADS * DIM
+
+
+class _Linear(nn.Module):
+    def __init__(self, seed):
+        super().__init__()
+        generator = torch.Generator().manual_seed(seed)
+        self.weight = torch.randn(CHANNELS, CHANNELS, generator=generator)
+        self.calls = 0
+
+    def forward(self, x):
+        self.calls += 1
+        return x @ self.weight.T, None
+
+
+def _attention(q, k, v):
+    out = torch.nn.functional.scaled_dot_product_attention(
+        q.transpose(1, 2), k.transpose(1, 2), v.transpose(1, 2)
+    )
+    return out.transpose(1, 2)
+
+
+def _module():
+    """CausalWanT2VCrossAttention with CPU stand-ins for its projections and attention backend."""
+    module = CausalWanT2VCrossAttention.__new__(CausalWanT2VCrossAttention)
+    nn.Module.__init__(module)
+    module.to_q, module.to_k, module.to_v, module.to_out = (
+        _Linear(1),
+        _Linear(2),
+        _Linear(3),
+        _Linear(4),
+    )
+    module.norm_q = module.norm_k = nn.Identity()
+    module.tp_rmsnorm = False
+    module.local_num_heads, module.head_dim = HEADS, DIM
+    module.attn = _attention
+    return module
+
+
+def test_stock_causal_block_builds_a_cache_aware_cross_attention():
+    assert issubclass(CausalWanT2VCrossAttention, WanT2VCrossAttention)
+    assert "crossattn_cache" in inspect.signature(CausalWanT2VCrossAttention.forward).parameters
+    source = inspect.getsource(causal_wanvideo.CausalWanTransformerBlock.__init__)
+    assert "self.attn2 = CausalWanT2VCrossAttention(" in source
+    block_forward = inspect.getsource(causal_wanvideo.CausalWanTransformerBlock.forward)
+    assert "crossattn_cache=crossattn_cache" in block_forward
+
+
+def test_cached_cross_attention_equals_uncached_and_projects_context_once():
+    module = _module()
+    generator = torch.Generator().manual_seed(0)
+    x = torch.randn(1, TOKENS, CHANNELS, generator=generator)
+    context = torch.randn(1, CONTEXT, CHANNELS, generator=generator)
+    reference = WanT2VCrossAttention.forward(module, x, context, None)
+    assert (module.to_k.calls, module.to_v.calls) == (1, 1)
+    cache = CrossAttentionKVCache(
+        k=torch.zeros(1, CONTEXT, HEADS, DIM), v=torch.zeros(1, CONTEXT, HEADS, DIM)
+    )
+    first = module(x, context, crossattn_cache=cache)
+    assert cache.is_init and torch.equal(first, reference)
+    second = module(x * 2, context * 0, crossattn_cache=cache)  # reuses the stored text K/V
+    assert (module.to_k.calls, module.to_v.calls) == (2, 2)
+    expected = WanT2VCrossAttention.forward(module, x * 2, context, None)
+    assert torch.allclose(second, expected, atol=1e-6, rtol=1e-6)
+    cache.reset()
+    third = module(x, context * 0, crossattn_cache=cache)
+    assert (module.to_k.calls, module.to_v.calls) == (4, 4)
+    assert not torch.allclose(third, reference)
+    without = module(x, context)  # no cache: exactly WanT2VCrossAttention.forward
+    assert torch.equal(without, reference)
