+# SPDX-License-Identifier: Apache-2.0
+"""Recache capture seam: a clean recache forward is captured whole and archived only where it was written."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.multimodal_gen.runtime.layers.kvcache import causal_kv_backend as seam
+from sglang.multimodal_gen.runtime.pipelines_core.stages.causal_denoising import (
+    CausalDMDDenoisingStage,
+)
+
+
+class _Run:
+    def __init__(self):
+        self.events = []
+
+    def stream_of(self, kv_cache):
+        return {"pos": "cond", "neg": "uncond"}[kv_cache]
+
+    def capture_layer(self, capture, layer_index, key, value, freqs_cis):
+        self.events.append(("layer", capture.kind, capture.stream, capture.chunk.index, layer_index))
+
+    def end_clean_forward(self, capture):
+        self.events.append(("end", capture.kind, capture.stream))
+
+    def end_recache(self, recache):
+        self.events.append(("recache", recache.epoch_id, recache.written))
+
+
+def _stage():
+    stage = CausalDMDDenoisingStage.__new__(CausalDMDDenoisingStage)
+    stage.num_token_per_frame = 4
+    return stage
+
+
+def _forward(stage, kv_cache, layers=2):
+    """What a clean forward does: the attention modules hand over their pre-RoPE K/V."""
+    with stage._causal_kv_capture_scope(kv_cache):
+        scope = seam.active_causal_kv_capture()
+        for layer in range(layers):
+            if scope is not None:
+                scope.capture_layer(layer, torch.zeros(1), torch.zeros(1), (None, None))
+
+
+def test_recache_descriptor_and_capture_kind():
+    stage = _stage()
+    batch = SimpleNamespace(extra={})
+    recache = stage._causal_kv_recache(
+        batch, window_start_frame=18, window_frames=12, written_frames=(21, 30), pos_start_base=0,
+        epoch_id="switch-c10", details={"prompt_segment": 1},
+    )
+    assert (recache.window.index, recache.window.start_frame, recache.window.num_frames) == (-1, 18, 12)
+    assert (recache.window.token_start, recache.window.num_tokens, recache.window.rope_start_frame) == (72, 48, 18)
+    assert recache.written == ((84, 36),) and recache.cause == "kv_recache"
+    assert recache.details == {"prompt_segment": 1}
+    with pytest.raises(ValueError):
+        stage._causal_kv_recache(batch, window_start_frame=18, window_frames=12, written_frames=(15, 30),
+                                 pos_start_base=0, epoch_id="bad")
+    run = _Run()
+    with seam.causal_kv_capture_scope(run, recache, "neg") as scope:
+        assert scope.capture.kind == "kv_recache" and scope.capture.chunk == recache.window
+    chunk = seam.CausalKVChunk(0, 0, 3, 0, 12, 0, False, 0)
+    with seam.causal_kv_capture_scope(run, chunk, "pos") as scope:
+        assert scope.capture.kind == "clean_commit"
+    assert run.events == [("end", "kv_recache", "uncond"), ("end", "clean_commit", "cond")]
+
+
+def test_recache_scope_captures_every_stream_then_commits_once():
+    stage, run = _stage(), _Run()
+    batch = SimpleNamespace(extra={})
+    recache = stage._causal_kv_recache(batch, window_start_frame=3, window_frames=9, written_frames=(6, 12),
+                                       pos_start_base=0, epoch_id="e1")
+    _forward(stage, "pos")  # nothing pending: no capture
+    assert run.events == []
+    with stage._causal_kv_recache_scope(run, recache):
+        _forward(stage, "pos")
+        _forward(stage, "neg")
+    assert stage._causal_kv_pending is None
+    assert run.events == [
+        ("layer", "kv_recache", "cond", -1, 0), ("layer", "kv_recache", "cond", -1, 1),
+        ("end", "kv_recache", "cond"),
+        ("layer", "kv_recache", "uncond", -1, 0), ("layer", "kv_recache", "uncond", -1, 1),
+        ("end", "kv_recache", "uncond"),
+        ("recache", "e1", ((24, 24),)),
+    ]
+    run.events.clear()
+    with pytest.raises(RuntimeError):
+        with stage._causal_kv_recache_scope(run, recache):
+            _forward(stage, "pos")
+            raise RuntimeError("recache forward failed")
+    assert ("recache", "e1", ((24, 24),)) not in run.events  # a failed recache is never committed
+    assert stage._causal_kv_pending is None
+    with stage._causal_kv_recache_scope(None, recache):  # ordinary generation: no backend run
+        _forward(stage, "pos")
+    assert stage._causal_kv_pending is None
+
+
+def test_attach_numbers_the_attention_modules_of_the_built_dit(monkeypatch):
+    """Capture lives in the self-attention modules; blocks re-classed or replaced after DiT construction
+    (e.g. precision policies of out-of-tree profiles) are numbered when the backend attaches."""
+    from sglang.multimodal_gen.configs.reelcache import ReelCacheArgs
+
+    blocks = [SimpleNamespace(attn1=SimpleNamespace(layer_index=None)) for _ in range(3)]
+    attached = []
+
+    class Stage:
+        transformer = SimpleNamespace(blocks=blocks)
+
+        def set_causal_kv_backend(self, backend):
+            attached.append(backend)
+
+    created = []
+
+    def create_sglang_backend(*, config, pipeline, server_args):
+        created.append(([block.attn1.layer_index for block in blocks], config))
+        return "backend"
+
+    monkeypatch.setattr(seam.importlib, "import_module",
+                        lambda name: SimpleNamespace(create_sglang_backend=create_sglang_backend))
+    args = ReelCacheArgs(enabled=True, config={"store_root": "/unused"}).validate()
+    backend = seam.attach_causal_kv_backend(SimpleNamespace(stages=[Stage()]), SimpleNamespace(reelcache_config=args))
+    assert backend == "backend" and attached == ["backend"]
+    assert created == [([0, 1, 2], {"store_root": "/unused", "hevc_inter_prediction": False})]
