+# SPDX-License-Identifier: Apache-2.0
+"""Resident causal KV across requests: K/V mutation generation and index state."""
+
+import pytest
+import torch
+
+from sglang.multimodal_gen.runtime.layers.kvcache.causal_attention_cache import (
+    CausalSelfAttentionKVCache,
+)
+
+TPF, CHUNK_FRAMES, CACHE_FRAMES = 2, 3, 12
+CHUNK = CHUNK_FRAMES * TPF
+
+
+def _cache(*, sink_frames=3, global_sink_frames=3, allow_growth=False, cache_frames=CACHE_FRAMES):
+    shape = [1, cache_frames * TPF, 2, 4]
+    return CausalSelfAttentionKVCache(
+        k=torch.zeros(shape),
+        v=torch.zeros(shape),
+        global_end_index=torch.zeros(1, dtype=torch.long),
+        local_end_index=torch.zeros(1, dtype=torch.long),
+        cache_size=cache_frames * TPF,
+        sink_tokens=sink_frames * TPF,
+        global_sink_tokens=global_sink_frames * TPF,
+        allow_growth=allow_growth,
+    )
+
+
+def _chunk(cache, index, generator, *, pin=False):
+    """A denoising write and then the clean write of chunk ``index`` (as the stages do)."""
+    view = None
+    for _ in range(2):
+        key = torch.randn(1, CHUNK, 2, 4, generator=generator)
+        view = cache.update_and_get_attention_kv(key=key, value=key * 2, current_chunk_start=index * CHUNK)
+    if pin:
+        cache.pin_current_chunk(CHUNK)
+    return view
+
+
+def test_generation_renews_on_kv_writes_only():
+    cache = _cache()
+    other = _cache()
+    assert cache.mutation_generation != other.mutation_generation
+    generator = torch.Generator().manual_seed(0)
+    seen = {cache.mutation_generation}
+    _chunk(cache, 0, generator)
+    assert cache.mutation_generation not in seen
+    seen.add(cache.mutation_generation)
+    generation = cache.mutation_generation
+    cache.pin_current_chunk(CHUNK)
+    cache.reset_pinned_sink()
+    cache._read_indices()
+    cache.reset_indices()
+    assert cache.mutation_generation == generation  # cursors and pins only
+
+    layout = cache.replay_layout([(0, CHUNK, False)])
+    assert cache.mutation_generation == generation  # the replay runs on a CPU shadow
+    cache.install_restored_history(layout, lambda span, k, v: None)
+    assert cache.mutation_generation not in seen
+
+    growable = _cache(sink_frames=0, global_sink_frames=0, allow_growth=True, cache_frames=1)
+    before = growable.mutation_generation
+    growable._grow_to_fit(4 * CHUNK)
+    assert growable.mutation_generation != before
+    grown = growable.mutation_generation
+    growable._grow_to_fit(CHUNK)  # no growth needed: unchanged
+    assert growable.mutation_generation == grown
+
+
+@pytest.mark.parametrize("pins", [set(), {1, 4}])
+def test_restored_index_state_continues_bitwise(pins):
+    """Request 1 (chunks 0..4) ends; the stage resets cursors; request 2 reinstates them and continues."""
+    generator = torch.Generator().manual_seed(1)
+    resident = _cache()
+    for index in range(5):
+        _chunk(resident, index, generator, pin=index in pins)
+    state = resident.index_state()
+    reference = CausalSelfAttentionKVCache(
+        k=resident.k.clone(),
+        v=resident.v.clone(),
+        global_end_index=resident.global_end_index.clone(),
+        local_end_index=resident.local_end_index.clone(),
+        global_end_index_int=resident.global_end_index_int,
+        local_end_index_int=resident.local_end_index_int,
+        cache_size=resident.cache_size,
+        sink_tokens=resident.sink_tokens,
+        global_sink_tokens=resident.global_sink_tokens,
+        pinned_start=resident.pinned_start,
+        pinned_len=resident.pinned_len,
+    )
+    resident.reset_indices()  # the next request's stage reset
+    assert resident._read_indices() == (0, 0) and resident.pinned_start == -1
+    assert resident.holds_index_state(state)
+    resident.restore_index_state(state)
+    assert resident._read_indices() == (state.global_end_index, state.local_end_index)
+    assert (resident.pinned_start, resident.pinned_len) == (state.pinned_start, state.pinned_len)
+    assert int(resident.global_end_index.item()) == state.global_end_index
+    assert int(resident.local_end_index.item()) == state.local_end_index
+    resumed, uninterrupted = torch.Generator().manual_seed(2), torch.Generator().manual_seed(2)
+    for index in range(5, 9):
+        view = _chunk(resident, index, resumed, pin=index in pins)
+        expected = _chunk(reference, index, uninterrupted, pin=index in pins)
+        assert torch.equal(view.k, expected.k) and torch.equal(view.v, expected.v)
+    assert torch.equal(resident.k, reference.k) and torch.equal(resident.v, reference.v)
+    assert resident._read_indices() == reference._read_indices()
+
+
+def test_index_state_is_refused_after_any_kv_write_or_reallocation():
+    generator = torch.Generator().manual_seed(3)
+    cache = _cache()
+    for index in range(3):
+        _chunk(cache, index, generator)
+    state = cache.index_state()
+    cache.reset_indices()
+    _chunk(cache, 0, generator)  # another request wrote the cache
+    cache.reset_indices()
+    assert not cache.holds_index_state(state)
+    with pytest.raises(ValueError):
+        cache.restore_index_state(state)
+    assert cache._read_indices() == (0, 0)  # refused without touching the cursors
+
+    copy = CausalSelfAttentionKVCache(  # same contents, another object (stage re-init)
+        k=cache.k.clone(),
+        v=cache.v.clone(),
+        global_end_index=torch.zeros(1, dtype=torch.long),
+        local_end_index=torch.zeros(1, dtype=torch.long),
+        cache_size=cache.cache_size,
+        sink_tokens=cache.sink_tokens,
+        global_sink_tokens=cache.global_sink_tokens,
+    )
+    assert not copy.holds_index_state(cache.index_state())
