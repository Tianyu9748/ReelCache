 # SPDX-License-Identifier: Apache-2.0
 
+from collections.abc import Callable, Sequence
 from dataclasses import dataclass
 
 import torch
 
 
+@dataclass(frozen=True, slots=True)
+class CausalKVSlotSpan:
+    """Cache slots ``[local_start, local_end)`` hold global tokens from ``global_start``."""
+
+    local_start: int
+    local_end: int
+    global_start: int
+
+    @property
+    def length(self) -> int:
+        return self.local_end - self.local_start
+
+
+@dataclass(frozen=True, slots=True)
+class CausalKVCacheLayout:
+    """Slot layout of a causal KV cache at a clean chunk boundary (plain data).
+
+    ``live`` maps every written slot ``[0, local_end_index)`` to its global
+    token position; ``attended`` (when computed for a next chunk) is the subset
+    of live slots that the next chunk's attention reads. Slots that are live but
+    not attended are evicted by the next append before any read.
+    """
+
+    cache_size: int
+    sink_tokens: int
+    global_sink_tokens: int
+    attention_window_size: int
+    global_end_index: int
+    local_end_index: int
+    pinned_start: int
+    pinned_len: int
+    live: tuple[CausalKVSlotSpan, ...]
+    attended: tuple[CausalKVSlotSpan, ...] | None = None
+
+
+def _position_spans(
+    positions: list[int], keep: set[int] | None = None
+) -> tuple[CausalKVSlotSpan, ...]:
+    spans: list[CausalKVSlotSpan] = []
+    start = None
+    for slot, position in enumerate(positions + [None]):
+        selected = position is not None and (keep is None or position in keep)
+        if start is not None and (
+            not selected or position != positions[start] + (slot - start)
+        ):
+            spans.append(CausalKVSlotSpan(start, slot, positions[start]))
+            start = None
+        if selected and start is None:
+            start = slot
+    return tuple(spans)
+
+
