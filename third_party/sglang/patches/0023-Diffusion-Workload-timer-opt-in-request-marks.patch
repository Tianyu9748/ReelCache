diff --git a/python/sglang/multimodal_gen/runtime/utils/workload_timer.py b/python/sglang/multimodal_gen/runtime/utils/workload_timer.py
new file mode 100644
index 0000000000..2a134b1a03
--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/utils/workload_timer.py
@@ -0,0 +1,208 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in per-request timer for the workload-v2 benchmark (marks and spans; no ReelCache import).
+
+The GPU worker attaches a :class:`WorkloadTimer` as ``req.extra["wl_timer"]`` when the request asks for it
+(``req.extra["workload_timing"] is True``) or the environment sets ``SGLANG_WL_TIMER=1``; requests without it
+record nothing and run exactly as before. With a timer:
+
+* marks (the first occurrence of a name counts):
+
+  - ``t1_dispatch``: ``GPUWorker.execute_forward`` entry (single-request batches);
+  - ``t2_first_new_denoise``: the causal denoising stage, immediately before the request's first denoise forward,
+    i.e. that of the first block that was not restored, after the restore, prompt transition and recache forwards
+    were issued (clean forwards never count);
+  - ``vae_begin`` / ``vae_end``: the decoding stage, around the VAE decode (context and new latents);
+  - ``rgb_ready``: the worker, once the output's uint8 RGB ``[F, H, W, 3]`` is on the CPU (``return_frames``);
+
+* spans: ``text_encode`` (a text-encoder call, or a text-embedding cache miss) and ``text_encode_cached`` (a
+  text-embedding cache hit).
+
+Host times are ``time.monotonic_ns()`` (CLOCK_MONOTONIC: comparable across processes on one node). GPU times come
+from CUDA events with ``enable_timing`` recorded on the current stream; they are read only by :meth:`resolve`,
+after the request's output exists (the RGB copy to the CPU has synchronized), so recording adds no
+synchronization. The worker stores the resolved dict as ``req.extra["wl_timing"]``::
+
+    {"marks": {name: {"host_ns": int, "gpu_ms_from_t1": float | None}},
+     "spans": [{"name": str, "host_start_ns": int, "host_end_ns": int, "gpu_ms": float | None}]}
+
+``gpu_ms_from_t1`` is the GPU time from the ``t1_dispatch`` event to the mark's event (None without CUDA, without
+``t1_dispatch`` or when an event cannot be read).
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+import time
+from contextlib import contextmanager, nullcontext
+from contextvars import ContextVar
+from typing import Any, Iterator
+
+import torch
+
+WL_TIMER_KEY = "wl_timer"  # req.extra: the attached WorkloadTimer
+WL_TIMING_KEY = "wl_timing"  # req.extra: the resolved dict
+WL_TIMING_REQUEST_KEY = "workload_timing"  # req.extra: True asks for a timer
+WL_TIMER_ENV = "SGLANG_WL_TIMER"  # "1": every request gets a timer
+
+T1_DISPATCH = "t1_dispatch"
+T2_FIRST_NEW_DENOISE = "t2_first_new_denoise"
+VAE_BEGIN = "vae_begin"
+VAE_END = "vae_end"
+RGB_READY = "rgb_ready"
+TEXT_ENCODE = "text_encode"
+TEXT_ENCODE_CACHED = "text_encode_cached"
+
+_TRUE = ("1", "true", "yes", "on")
+
+
+class WorkloadTimer:
+    """Marks and spans of one request: host ``monotonic_ns`` plus CUDA events, resolved after the request."""
+
+    __slots__ = ("_cuda", "_marks", "_spans")
+
+    def __init__(self, *, cuda: bool | None = None) -> None:
+        self._cuda = torch.cuda.is_available() if cuda is None else bool(cuda)
+        self._marks: dict[str, tuple[int, Any]] = {}
+        self._spans: list[list[Any]] = []  # [name, host_start_ns, host_end_ns, start_event, end_event]
+
+    def _event(self):
+        if not self._cuda:
+            return None
+        event = torch.cuda.Event(enable_timing=True)
+        event.record()
+        return event
+
+    def mark(self, name: str) -> None:
+        """Record ``name`` now (host clock and the current stream); a name is recorded once."""
+        if name in self._marks:
+            return
+        host_ns = time.monotonic_ns()
+        self._marks[name] = (host_ns, self._event())
+
+    def has_mark(self, name: str) -> bool:
+        return name in self._marks
+
+    @contextmanager
+    def span(self, name: str) -> Iterator[None]:
+        """Time the enclosed block (host clock and the current stream); spans keep their start order."""
+        record = [name, time.monotonic_ns(), None, self._event(), None]
+        self._spans.append(record)
+        try:
+            yield
+        finally:
+            record[4] = self._event()
+            record[2] = time.monotonic_ns()
+
+    def resolve(self) -> dict[str, Any]:
+        """The plain-data timing dict (waits for the recorded events, which have completed once the request's output
+        is on the CPU)."""
+        t1 = self._marks.get(T1_DISPATCH)
+        t1_event = None if t1 is None else t1[1]
+        marks = {
+            name: {"host_ns": int(host_ns), "gpu_ms_from_t1": _elapsed_ms(t1_event, event)}
+            for name, (host_ns, event) in self._marks.items()
+        }
+        spans = [
+            {
+                "name": name,
+                "host_start_ns": int(start),
+                "host_end_ns": None if end is None else int(end),
+                "gpu_ms": _elapsed_ms(start_event, end_event),
+            }
+            for name, start, end, start_event, end_event in self._spans
+        ]
+        return {"marks": marks, "spans": spans}
+
+    # A request copy (``copy.deepcopy`` / ``dataclasses.asdict`` of a Req) shares its timer; pickling keeps the host
+    # clock only (CUDA events do not cross processes).
+    def __deepcopy__(self, memo):
+        return self
+
+    def __reduce__(self):
+        marks = {name: host_ns for name, (host_ns, _) in self._marks.items()}
+        spans = [record[:3] for record in self._spans]
+        return (_host_only_timer, (marks, spans))
+
+
+def _host_only_timer(marks: dict[str, int], spans: list[list[Any]]) -> WorkloadTimer:
+    timer = WorkloadTimer(cuda=False)
+    timer._marks = {name: (host_ns, None) for name, host_ns in marks.items()}
+    timer._spans = [list(record) + [None, None] for record in spans]
+    return timer
+
+
+def _elapsed_ms(start, end) -> float | None:
+    if start is None or end is None:
+        return None
+    try:
+        end.synchronize()
+        start.synchronize()
+        return float(start.elapsed_time(end))
+    except RuntimeError:  # e.g. an event that was never recorded, or a failed device
+        return None
+
+
+def workload_timing_requested(req: Any) -> bool:
+    """``req.extra["workload_timing"] is True`` or ``SGLANG_WL_TIMER=1``."""
+    extra = getattr(req, "extra", None)
+    if isinstance(extra, dict) and extra.get(WL_TIMING_REQUEST_KEY) is True:
+        return True
+    return os.environ.get(WL_TIMER_ENV, "").strip().lower() in _TRUE
+
+
+def attach_workload_timer(req: Any) -> WorkloadTimer | None:
+    """A fresh timer as ``req.extra["wl_timer"]`` when the request asks for one; None (and nothing touched) else."""
+    if not workload_timing_requested(req):
+        return None
+    timer = WorkloadTimer()
+    req.extra[WL_TIMER_KEY] = timer
+    return timer
+
+
+def workload_timer(batch: Any) -> WorkloadTimer | None:
+    """The timer attached to ``batch`` (a Req), or None."""
+    extra = getattr(batch, "extra", None)
+    if not extra:
+        return None
+    timer = extra.get(WL_TIMER_KEY)
+    return timer if isinstance(timer, WorkloadTimer) else None
+
+
+def wl_mark(batch: Any, name: str) -> None:
+    """``mark(name)`` on the batch's timer; nothing without one."""
+    timer = workload_timer(batch)
+    if timer is not None:
+        timer.mark(name)
+
+
+def wl_span(batch: Any, name: str):
+    """``span(name)`` on the batch's timer; a no-op context without one."""
+    timer = workload_timer(batch)
+    return nullcontext() if timer is None else timer.span(name)
+
+
+# Code that has no batch at hand (``TextEncodingStage.encode_text``) finds the running request's timer here; the
+# stage methods decorated with ``bind_workload_timer`` set it from their batch argument.
+_CURRENT: ContextVar[WorkloadTimer | None] = ContextVar("sglang_wl_timer", default=None)
+
+
+def current_workload_timer() -> WorkloadTimer | None:
+    return _CURRENT.get()
+
+
+def bind_workload_timer(method):
+    """Decorate a stage method ``(self, batch, ...)``: the batch's timer is the current one while it runs."""
+
+    @functools.wraps(method)
+    def wrapper(self, batch, *args, **kwargs):
+        timer = workload_timer(batch)
+        if timer is None:
+            return method(self, batch, *args, **kwargs)
+        token = _CURRENT.set(timer)
+        try:
+            return method(self, batch, *args, **kwargs)
+        finally:
+            _CURRENT.reset(token)
+
+    return wrapper
diff --git a/python/sglang/multimodal_gen/test/unit/test_wl_timer.py b/python/sglang/multimodal_gen/test/unit/test_wl_timer.py
