@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Optional workload metadata of causal KV session requests (workload-v2).
+
+``req.extra["workload"]`` (plain JSON) reaches the backend as ``CausalKVRequest.generation_index`` / ``.workload``;
+it is never part of the request's conditioning identity, and without it the request is exactly as before.
+"""
+
+import dataclasses
+import math
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.multimodal_gen.runtime.layers.kvcache import causal_kv_backend as seam
+from sglang.multimodal_gen.runtime.pipelines_core.stages.causal_denoising import (
+    CausalDMDDenoisingStage,
+)
+
+
+def test_metadata_validation():
+    assert seam.causal_kv_workload_metadata(None) == (None, None)
+    source = {"generation_index": 7, "request_id": "r-0007", "k": 2, "planned": {"source": "n3"}}
+    index, workload = seam.causal_kv_workload_metadata(source)
+    assert index == 7 and workload == source
+    source["planned"]["source"] = "changed"
+    assert workload["planned"]["source"] == "n3"  # a plain copy, not the caller's object
+    assert seam.causal_kv_workload_metadata({"k": 0}) == (None, {"k": 0})
+    for bad in ([1], "w", {"live": object()}, {"x": math.nan}, {"generation_index": -1},
+                {"generation_index": "3"}, {"generation_index": True}, {"generation_index": 1.0}):
+        with pytest.raises(ValueError):
+            seam.causal_kv_workload_metadata(bad)
+
+
+def test_request_fields_default_to_none():
+    names = [f.name for f in dataclasses.fields(seam.CausalKVRequest)]
+    assert names[-2:] == ["generation_index", "workload"]
+    request = seam.CausalKVRequest("r", None, {}, (3,), 4, (2, 2), 0, ("cond",), 1, 2, 4, "bfloat16", {})
+    assert request.generation_index is None and request.workload is None and request.dispatched_at is None
+
+
+class _Backend:
+    def __init__(self):
+        self.requests = []
+
+    def begin_request(self, request):
+        self.requests.append(request)
+        return None  # no run: nothing to restore
+
+
+def _stage(backend):
+    stage = CausalDMDDenoisingStage.__new__(CausalDMDDenoisingStage)
+    stage._causal_kv_backend = backend
+    stage.transformer = SimpleNamespace(
+        causal_rotary_cos_sin=lambda *a, **k: (None, None),
+        causal_rotate_key=lambda *a, **k: None,
+        config=SimpleNamespace(patch_size=(1, 2, 2)),
+    )
+    stage.num_token_per_frame = 4
+    stage.num_transformer_blocks = 1
+    stage.num_frames_per_block = 3
+    return stage
+
+
+def _begin(stage, extra):
+    batch = SimpleNamespace(
+        causal_kv_session={"session_id": "s", "action": "generate"},
+        is_warmup=False,
+        extra=extra,
+        image_latent=None,
+        request_id="r-0007",
+        sampling_params=None,
+    )
+    cache = SimpleNamespace(
+        k=torch.zeros(1, 24, 2, 4, dtype=torch.bfloat16),
+        cache_size=24,
+        sink_tokens=0,
+        global_sink_tokens=0,
+        attention_window_size=24,
+    )
+    return stage._begin_causal_kv_run(
+        batch,
+        SimpleNamespace(model_path="/models/m"),
+        ctx=SimpleNamespace(height=4, width=4),
+        block_sizes=[3, 3],
+        pos_start_base=0,
+        use_cfg=False,
+        kv_cache=[cache],
+        kv_cache_neg=None,
+        latents=torch.zeros(1, 4, 6, 4, 4),
+    )
+
+
+def test_metadata_reaches_the_backend_outside_the_identity():
+    backend = _Backend()
+    stage = _stage(backend)
+    assert _begin(stage, {}) == (None, 0)
+    metadata = {"generation_index": 12, "request_id": "r-0007", "k": 3, "session_tree": "t1"}
+    assert _begin(stage, {"workload": metadata}) == (None, 0)
+    plain, tagged = backend.requests
+    assert plain.generation_index is None and plain.workload is None
+    assert tagged.generation_index == 12 and tagged.workload == metadata and tagged.workload is not metadata
+    # everything else, the conditioning identity included, is unchanged by the metadata
+    assert dataclasses.replace(tagged, generation_index=None, workload=None) == plain
+    with pytest.raises(ValueError):
+        _begin(stage, {"workload": {"generation_index": -2}})
+    assert len(backend.requests) == 2  # an invalid request never reaches the backend
+
+
+def test_metadata_is_ignored_without_a_backend():
+    stage = _stage(None)
+    batch_extra = {"workload": {"generation_index": "not checked"}}
+    plain = SimpleNamespace(causal_kv_session=None, is_warmup=False, extra=batch_extra)
+    assert stage._begin_causal_kv_run(
+        plain, None, ctx=None, block_sizes=[3], pos_start_base=0, use_cfg=False,
+        kv_cache=None, kv_cache_neg=None, latents=torch.zeros(1),
+    ) == (None, 0)
