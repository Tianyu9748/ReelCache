+    def index_state(self) -> CausalKVIndexState:
+        """Cursors, pinned sink and geometry now, tagged with the current K/V contents."""
+        global_end, local_end = self._read_indices()
+        return CausalKVIndexState(
+            mutation_generation=self.mutation_generation,
+            global_end_index=global_end,
+            local_end_index=local_end,
+            pinned_start=self.pinned_start,
+            pinned_len=self.pinned_len,
+            cache_size=self.cache_size,
+            sink_tokens=self.sink_tokens,
+            global_sink_tokens=self.global_sink_tokens,
+            attention_window_size=self.attention_window_size,
+            allow_growth=self.allow_growth,
+        )
+
+    def holds_index_state(self, state: CausalKVIndexState) -> bool:
+        """True when ``state`` was taken from this cache and no K/V write happened since."""
+        return (
+            state.mutation_generation,
+            state.cache_size,
+            state.sink_tokens,
+            state.global_sink_tokens,
+            state.attention_window_size,
+            state.allow_growth,
+        ) == (
+            self.mutation_generation,
+            self.cache_size,
+            self.sink_tokens,
+            self.global_sink_tokens,
+            self.attention_window_size,
+            self.allow_growth,
+        )
+
+    def restore_index_state(self, state: CausalKVIndexState) -> None:
+        """Reinstate the cursors and pinned sink of ``state`` over unchanged K/V.
+
+        Lets a backend continue a session on native KV that stayed resident in
+        this cache between requests (the stage only resets the cursors). Raises
+        ``ValueError`` when the K/V contents or the geometry changed since
+        ``state`` was taken.
+        """
+        if not self.holds_index_state(state):
+            raise ValueError(
+                "causal KV cache contents changed since the index state was taken"
+            )
+        self._write_indices(
+            global_end_index=state.global_end_index,
+            local_end_index=state.local_end_index,
+        )
+        self.pinned_start = state.pinned_start
+        self.pinned_len = state.pinned_len
+
 
