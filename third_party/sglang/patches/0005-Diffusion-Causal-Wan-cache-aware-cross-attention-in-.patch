diff --git a/python/sglang/multimodal_gen/runtime/models/dits/causal_wanvideo.py b/python/sglang/multimodal_gen/runtime/models/dits/causal_wanvideo.py
index e4b78b34c1..0811a09d8b 100644
--- a/python/sglang/multimodal_gen/runtime/models/dits/causal_wanvideo.py
+++ b/python/sglang/multimodal_gen/runtime/models/dits/causal_wanvideo.py
@@ -218,6 +218,49 @@ class CausalWanSelfAttention(nn.Module):
         return x
 
 
+class CausalWanT2VCrossAttention(WanT2VCrossAttention):
+    """``WanT2VCrossAttention`` that reuses the text K/V held by a ``CrossAttentionKVCache``.
+
+    The causal stages pass one cache per block: the first call after a reset
+    projects (and normalizes) the context K/V and stores them, later calls of
+    the same chunk reuse them (the same math as LongLive2's
+    ``_cross_attn_with_cache``). Without a cache it is exactly
+    ``WanT2VCrossAttention.forward``.
+    """
+
+    def forward(
+        self,
+        x,
+        context,
+        context_lens=None,
+        crossattn_cache: CrossAttentionKVCache | None = None,
+    ):
+        if crossattn_cache is None:
+            return super().forward(x, context, context_lens)
+        q, _ = self.to_q(x)
+        if self.tp_rmsnorm:
+            q = tensor_parallel_rms_norm(q, self.norm_q)
+        else:
+            q = self.norm_q(q)
+        q = q.unflatten(2, (self.local_num_heads, self.head_dim))
+        if crossattn_cache.is_init:
+            k, v = crossattn_cache.k, crossattn_cache.v
+        else:
+            k, _ = self.to_k(context)
+            if self.tp_rmsnorm:
+                k = tensor_parallel_rms_norm(k, self.norm_k)
+            else:
+                k = self.norm_k(k)
+            k = k.unflatten(2, (self.local_num_heads, self.head_dim))
+            v, _ = self.to_v(context)
+            v = v.unflatten(2, (self.local_num_heads, self.head_dim))
+            crossattn_cache.store(k, v)
+        x = self.attn(q, k, v)
+        x = x.flatten(2)
+        x, _ = self.to_out(x)
+        return x
+
+
 class CausalWanTransformerBlock(nn.Module):
     def __init__(
         self,
@@ -327,7 +370,9 @@ class CausalWanTransformerBlock(nn.Module):
         cross_attn_backends = {
             b for b in supported_attention_backends if not b.is_sparse
         }
-        self.attn2 = WanT2VCrossAttention(
+        # Cache-aware: forward() passes the block's crossattn_cache (e00930c passed it to
