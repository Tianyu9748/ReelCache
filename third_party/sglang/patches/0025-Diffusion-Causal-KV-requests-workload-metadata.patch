+CAUSAL_KV_WORKLOAD_KEY = "workload"
 
 
 def validate_causal_kv_session(value: Any) -> dict[str, Any] | None:
@@ -160,6 +165,27 @@ def validate_causal_kv_session(value: Any) -> dict[str, Any] | None:
     return result
 
 
+def causal_kv_workload_metadata(value: Any) -> tuple[int | None, dict[str, Any] | None]:
+    """Validate the optional workload metadata of a request (``req.extra["workload"]``).
+
+    ``None`` means none: ``(None, None)``. Otherwise a JSON object, returned as a
+    plain-JSON copy together with its ``generation_index`` (a non-negative int,
+    or None when absent). Live objects are rejected.
+    """
+    if value is None:
+        return None, None
+    if not isinstance(value, Mapping):
+        raise ValueError("req.extra['workload'] must be a JSON object or None")
+    try:
+        workload = json.loads(json.dumps(dict(value), allow_nan=False))
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"req.extra['workload'] must be plain JSON: {exc}") from exc
+    index = workload.get("generation_index")
+    if index is not None and (type(index) is not int or index < 0):
+        raise ValueError("req.extra['workload']['generation_index'] must be a non-negative int")
+    return index, workload
+
+
