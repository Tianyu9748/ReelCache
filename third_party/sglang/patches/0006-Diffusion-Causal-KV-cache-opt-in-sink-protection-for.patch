+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in sink protection for in-place recompute writes (LongLive 1.0 prompt-switch recache)."""
+
+import pytest
+import torch
+
+from sglang.multimodal_gen.runtime.layers.kvcache.causal_attention_cache import (
+    CausalSelfAttentionKVCache,
+)
+
+TPF, CHUNK_FRAMES, SINK_FRAMES, CACHE_FRAMES, CHUNKS = 2, 3, 3, 12, 10
+
+
+def _cache(protect, *, heads=2, global_sink=0):
+    shape = [1, CACHE_FRAMES * TPF, heads, 4]
+    return CausalSelfAttentionKVCache(
+        k=torch.zeros(shape),
+        v=torch.zeros(shape),
+        global_end_index=torch.zeros(1, dtype=torch.long),
+        local_end_index=torch.zeros(1, dtype=torch.long),
+        cache_size=CACHE_FRAMES * TPF,
+        sink_tokens=SINK_FRAMES * TPF,
+        global_sink_tokens=global_sink,
+        protect_sink_on_recompute=protect,
+    )
+
+
+def _generate(cache, generator, heads=2):
+    for index in range(CHUNKS):
+        start = index * CHUNK_FRAMES * TPF
+        for _ in range(2):  # a denoising write, then the clean write of the same chunk
+            key = torch.randn(1, CHUNK_FRAMES * TPF, heads, 4, generator=generator)
+            cache.update_and_get_attention_kv(key=key, value=-key, current_chunk_start=start)
+
+
+def _upstream_recompute(k, v, local_start, sink, key, value):
+    """Transcription of upstream LongLive's ``is_recompute`` write: from max(local_start, sink)."""
+    write_start = max(local_start, sink)
+    offset = write_start - local_start
+    k = k.clone()
+    v = v.clone()
+    k[:, write_start : local_start + key.shape[1]] = key[:, offset:]
+    v[:, write_start : local_start + key.shape[1]] = value[:, offset:]
+    return k, v
+
+
+@pytest.mark.parametrize("protect", [False, True])
+def test_recache_recompute_keeps_sink_only_when_enabled(protect):
+    generator = torch.Generator().manual_seed(3)
+    cache = _cache(protect)
+    _generate(cache, generator)
+    before_k, before_v = cache.k.clone(), cache.v.clone()
+    indices = cache._read_indices()
+    assert indices == (CHUNKS * CHUNK_FRAMES * TPF, CACHE_FRAMES * TPF)
+    # Recache: the last 12 frames under a new prompt, one unmasked clean forward.
+    window = CACHE_FRAMES * TPF
+    start = indices[0] - window
+    key = torch.randn(1, window, 2, 4, generator=generator)
+    view = cache.update_and_get_attention_kv(key=key, value=-key, current_chunk_start=start)
+    assert cache._read_indices() == indices  # a recompute never moves the indices
+    sink = SINK_FRAMES * TPF
+    if protect:
+        expected_k, expected_v = _upstream_recompute(before_k, before_v, 0, sink, key, -key)
+        assert torch.equal(cache.k, expected_k) and torch.equal(cache.v, expected_v)
+        assert torch.equal(cache.k[:, :sink], before_k[:, :sink])  # sink KV kept
+    else:  # e00930c behavior (unchanged by default): the sink is overwritten
+        assert torch.equal(cache.k, key) and torch.equal(cache.v, -key)
+    assert torch.equal(view.k, cache.k) and torch.equal(view.v, cache.v)  # attends sink + rewritten window
+
+
+def test_protection_never_changes_appends_and_supports_head_slices():
+    generator = torch.Generator().manual_seed(5)
+    plain, protected = _cache(False, heads=4), _cache(True, heads=4)
+    for index in range(CHUNKS):  # ordinary appends (head-sliced writes): identical with the flag
+        start = index * CHUNK_FRAMES * TPF
+        for head_start in (0, 2):
+            key = torch.randn(1, CHUNK_FRAMES * TPF, 2, 4, generator=generator)
+            for cache in (plain, protected):
+                cache.update_and_get_attention_kv(
+                    key=key, value=key, current_chunk_start=start, cache_head_start=head_start
+                )
+    assert torch.equal(plain.k, protected.k) and plain._read_indices() == protected._read_indices()
+    before = protected.k.clone()
+    end = protected._read_indices()[0]
+    # A 10-frame recompute starts 2 frames before the end of the 3-frame sink.
+    sink, recompute = SINK_FRAMES * TPF, 10 * TPF
+    key = torch.randn(1, recompute, 2, 4, generator=generator)
+    protected.update_and_get_attention_kv(
+        key=key, value=key, current_chunk_start=end - recompute, cache_head_start=2
+    )
+    local_start = CACHE_FRAMES * TPF - recompute
+    assert torch.equal(protected.k[:, :sink], before[:, :sink])
+    assert torch.equal(protected.k[:, sink:, 2:], key[:, sink - local_start :])
+    assert torch.equal(protected.k[:, sink:, :2], before[:, sink:, :2])
+    # A recompute that starts at token 0 is not a recompute (upstream: current_start > 0).
+    fresh = _cache(True)
+    first = torch.randn(1, CHUNK_FRAMES * TPF, 2, 4, generator=generator)
+    fresh.update_and_get_attention_kv(key=first, value=first, current_chunk_start=0)
+    again = torch.randn(1, CHUNK_FRAMES * TPF, 2, 4, generator=generator)
+    fresh.update_and_get_attention_kv(key=again, value=again, current_chunk_start=0)
+    assert torch.equal(fresh.k[:, : CHUNK_FRAMES * TPF], again)
