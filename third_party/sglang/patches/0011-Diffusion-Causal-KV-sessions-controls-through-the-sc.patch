+def test_session_router_is_registered_only_with_reelcache():
+    from sglang.multimodal_gen.runtime.entrypoints import http_server
+
+    def collect(routes):
+        found = set()
+        for route in routes:
+            path = getattr(route, "path", None)
+            if path is not None:
+                found.add(path)
+            nested = (
+                getattr(route, "routes", None)
+                or getattr(getattr(route, "original_router", None), "routes", None)
+                or getattr(getattr(route, "router", None), "routes", None)
+            )
+            if nested:
+                found |= collect(nested)
+        return found
+
+    def paths(enabled):
+        server_args = SimpleNamespace(
+            enable_metrics=False,
+            reelcache_config=ReelCacheArgs(enabled=enabled),
+            pipeline_config=SimpleNamespace(
+                supports_action_endpoint=lambda: False,
+                supports_openpi_endpoint=lambda: False,
+            ),
+        )
+        return collect(http_server.create_app(server_args).routes)
+
+    assert "/v1/sessions/{session_id}/pause" in paths(True)
+    assert not [path for path in paths(False) if path.startswith("/v1/session")]
+
