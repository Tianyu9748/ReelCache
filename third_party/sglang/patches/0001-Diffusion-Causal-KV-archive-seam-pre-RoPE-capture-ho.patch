+# SPDX-License-Identifier: Apache-2.0
+"""Optional archive backend seam for causal self-attention KV caches.
+
+Disabled by default: no backend is attached to the causal denoising stages,
+``active_causal_kv_capture()`` returns ``None`` and the attention and denoising
+code paths do exactly what they did before (no copies, no imports). An enabled
+backend, e.g. ReelCache's ``reelcache.integrations.sglang`` (``--reelcache-enable``), is
+created once per GPU worker by :func:`attach_causal_kv_backend` and receives:
+
+* the normalized pre-RoPE ``key`` and the ``value`` of every causal
+  self-attention layer, in native dtype and ``[B, T, H, D]`` layout, during the
+  *clean* context forward of a chunk only (never denoising-step forwards, never
+  post-RoPE keys);
+* chunk-boundary callbacks (``end_chunk``) that can request a pause at the
+  clean boundary;
+* a restore target (:class:`CausalKVRestoreTarget`) through which restored
+  history is installed into ``CausalSelfAttentionKVCache`` slots with
+  ``install_restored_history`` and re-rotated with the engine's own RoPE.
+
+Everything crossing this seam is plain data or a live tensor owned by the
+worker; nothing here is serialized into requests.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import importlib
+from dataclasses import dataclass
+from typing import Any, Callable, Iterator, Mapping, Protocol, Sequence
+
+import torch
+
+# Request field (``SamplingParams.causal_kv_session``) keys understood by the seam.
+SESSION_ACTIONS = ("generate", "resume", "fork", "rewind")
+_SESSION_KEYS = {
+    "session_id",
+    "action",
+    "pause_after_chunks",
+    "from_session",
+    "checkpoint",
+    "replace",
+}
+
+
+def validate_causal_kv_session(value: Any) -> dict[str, Any] | None:
+    """Validate the plain-data session handle of a request (no backend import).
+
+    ``None`` means ordinary generation. Otherwise a JSON object with
+    ``session_id`` (str), ``action`` (one of :data:`SESSION_ACTIONS`, default
+    ``generate``), optional ``pause_after_chunks`` (positive int: pause at the
+    clean boundary after that many chunks of the session), ``from_session``
+    (fork source), ``checkpoint`` (node reference or chunk count) and
+    ``replace`` (bool, ``generate`` only). Live objects are rejected.
+    """
+    if value is None:
+        return None
+    if not isinstance(value, Mapping):
+        raise ValueError("causal_kv_session must be a JSON object or None")
+    unknown = set(value) - _SESSION_KEYS
+    if unknown:
+        raise ValueError(f"unknown causal_kv_session keys: {sorted(unknown)}")
+    session_id = value.get("session_id")
+    if not isinstance(session_id, str) or not session_id.strip() or "/" in session_id:
+        raise ValueError("causal_kv_session.session_id must be a nonempty name without '/'")
+    action = value.get("action", "generate")
+    if action not in SESSION_ACTIONS:
+        raise ValueError(f"causal_kv_session.action must be one of {SESSION_ACTIONS}")
+    pause = value.get("pause_after_chunks")
+    if pause is not None and (type(pause) is not int or pause < 1):
+        raise ValueError("causal_kv_session.pause_after_chunks must be a positive int")
+    source = value.get("from_session")
+    if (action == "fork") != (source is not None):
+        raise ValueError("causal_kv_session.from_session is required for (and only for) fork")
+    if source is not None and (not isinstance(source, str) or not source.strip()):
+        raise ValueError("causal_kv_session.from_session must be a nonempty string")
+    checkpoint = value.get("checkpoint")
+    if checkpoint is not None and not (
+        (type(checkpoint) is int and checkpoint >= 0) or isinstance(checkpoint, str)
+    ):
+        raise ValueError("causal_kv_session.checkpoint must be a node reference or chunk count")
+    if action == "rewind" and checkpoint is None:
+        raise ValueError("causal_kv_session.checkpoint is required for rewind")
+    replace = value.get("replace", False)
+    if type(replace) is not bool or (replace and action != "generate"):
+        raise ValueError("causal_kv_session.replace is a bool for generate only")
+    result = {"session_id": session_id, "action": action, "replace": replace}
+    for name, item in (
+        ("pause_after_chunks", pause),
+        ("from_session", source),
+        ("checkpoint", checkpoint),
+    ):
+        if item is not None:
+            result[name] = item
+    return result
+
+
+@dataclass(frozen=True, slots=True)
+class CausalKVChunk:
+    """One causal block of a request, in the stage's own coordinates."""
+
+    index: int  # block index within the request (0-based)
+    start_frame: int  # first latent frame of the block within the request
+    num_frames: int  # latent frames of the block
+    token_start: int  # global cache position of the block's first token
+    num_tokens: int
+    rope_start_frame: float  # temporal RoPE position passed to the transformer
+    scene_cut: bool  # pinned as a shot sink after its clean forward
+    shot_index: int
+
+
+@dataclass(frozen=True, slots=True)
+class CausalKVCapture:
+    """The clean context forward being captured: one chunk of one CFG stream."""
+
+    chunk: CausalKVChunk
+    stream: str  # "cond" or "uncond"
+
+
+@dataclass(frozen=True, slots=True)
+class CausalKVRequest:
+    """Plain description of a request handed to ``CausalKVBackend.begin_request``."""
+
+    request_id: str | None
+    session: dict[str, Any]  # validated causal_kv_session handle
+    conditioning: dict[str, Any]  # JSON identity of prompt/seed/sampling/geometry
+    block_sizes: tuple[int, ...]  # latent frames per causal block
+    tokens_per_frame: int
+    grid: tuple[int, int]  # post-patch (height, width)
+    pos_start_base: int  # warm-up frames before block 0 (token offset base)
+    streams: tuple[str, ...]  # ("cond",) or ("cond", "uncond")
+    num_layers: int
+    num_heads: int
+    head_dim: int
+    dtype: str
+    model: dict[str, Any]  # pipeline/model identity (class names, path)
+
+
+@dataclass(slots=True)
+class CausalKVRestoreTarget:
+    """Live objects a backend needs to install restored history (worker-owned)."""
+
+    caches: Mapping[str, Sequence[Any]]  # stream -> per-layer CausalSelfAttentionKVCache
+    latents: torch.Tensor  # [B, C, T, H, W] request latents (restored blocks are written)
+    generator: Any  # torch.Generator or list of them
+    rope_cos_sin: Callable[[float, int], tuple[torch.Tensor, torch.Tensor]]
+    rotate_key: Callable[[torch.Tensor, torch.Tensor, torch.Tensor], torch.Tensor]
+    device: torch.device
+
+
+class CausalKVRun(Protocol):
+    """Per-request state of an enabled backend (one request at a time per worker)."""
+
+    resume_blocks: int
+
+    def restore(self, target: CausalKVRestoreTarget) -> int: ...
+
+    def capture_layer(
+        self,
+        capture: CausalKVCapture,
+        layer_index: int,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        freqs_cis: tuple[torch.Tensor, torch.Tensor],
+    ) -> None: ...
+
+    def end_clean_forward(self, capture: CausalKVCapture) -> None: ...
+
+    def stream_of(self, kv_cache: Any) -> str: ...
+
+    def end_chunk(self, chunk: CausalKVChunk, latents: torch.Tensor) -> bool: ...
+
+    def finish(self, *, error: BaseException | None) -> dict[str, Any]: ...
+
+
+class CausalKVBackend(Protocol):
+    """Worker-owned archive backend (e.g. ReelCache's CausalWanKVBridge)."""
+
+    def begin_request(self, request: CausalKVRequest) -> CausalKVRun | None: ...
+
+    def close(self) -> None: ...
+
+
+# --- capture scope -----------------------------------------------------------
+
+_ACTIVE_CAPTURE: "_CaptureScope | None" = None
+
+
+class _CaptureScope:
+    __slots__ = ("run", "capture", "layers")
+
+    def __init__(self, run: CausalKVRun, capture: CausalKVCapture) -> None:
+        self.run = run
+        self.capture = capture
+        self.layers = 0
+
+    def capture_layer(
+        self,
+        layer_index: int | None,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        freqs_cis: tuple[torch.Tensor, torch.Tensor],
+    ) -> None:
+        if layer_index is None:
+            raise RuntimeError(
+                "causal KV capture reached an attention module without a layer index"
+            )
+        self.layers += 1
+        self.run.capture_layer(self.capture, layer_index, key, value, freqs_cis)
+
+
+def active_causal_kv_capture() -> _CaptureScope | None:
+    """The capture scope of the running clean forward, or None (always None when disabled)."""
+    return _ACTIVE_CAPTURE
+
+
+@contextlib.contextmanager
+def causal_kv_capture_scope(
+    run: CausalKVRun, chunk: CausalKVChunk, kv_cache: Any
+) -> Iterator[_CaptureScope]:
+    """Capture the clean context forward of ``chunk`` into ``kv_cache``'s stream."""
+    global _ACTIVE_CAPTURE
+    if _ACTIVE_CAPTURE is not None:
+        raise RuntimeError("causal KV capture scopes cannot be nested")
+    scope = _CaptureScope(run, CausalKVCapture(chunk, run.stream_of(kv_cache)))
+    _ACTIVE_CAPTURE = scope
+    try:
+        yield scope
+    finally:
+        _ACTIVE_CAPTURE = None
+    run.end_clean_forward(scope.capture)
+
+
+def assign_causal_attention_layer_indices(blocks: Sequence[Any]) -> None:
+    """Number the causal self-attention modules of a transformer's blocks."""
+    for index, block in enumerate(blocks):
+        attention = getattr(block, "attn1", None)
+        if attention is not None:
+            attention.layer_index = index
+
+
+# --- worker attachment ---------------------------------------------------------
+
+
+def attach_causal_kv_backend(pipeline: Any, server_args: Any) -> CausalKVBackend | None:
+    """Create the worker's archive backend and attach it to the causal stages.
+
+    Returns None (and imports nothing) unless ``--reelcache-enable`` was given.
+    An explicitly enabled backend that cannot be imported or attached raises.
+    """
+    args = getattr(server_args, "reelcache_config", None)
+    if args is None or not args.enabled:
+        return None
+    from sglang.multimodal_gen.configs.reelcache import (
+        REELCACHE_BACKEND_MODULE,
+        ReelCacheUnavailableError,
+    )
+
+    stages = [
+        stage
+        for stage in getattr(pipeline, "stages", ())
+        if callable(getattr(stage, "set_causal_kv_backend", None))
+    ]
+    if not stages:
+        raise ReelCacheUnavailableError(
+            f"--reelcache-enable was requested but {type(pipeline).__name__} has no causal "
+            "KV archive seam (only causal denoising stages support it)"
+        )
+    try:
+        module = importlib.import_module(REELCACHE_BACKEND_MODULE)
+        factory = module.create_sglang_backend
+    except Exception as exc:  # noqa: BLE001 - surfaced as an explicit startup error
+        raise ReelCacheUnavailableError(
+            f"--reelcache-enable was requested but {REELCACHE_BACKEND_MODULE} could not be "
+            f"loaded: {exc!r}"
+        ) from exc
+    backend = factory(
+        config=args.backend_config(),
+        pipeline=pipeline,
+        server_args=server_args,
+    )
+    for stage in stages:
+        stage.set_causal_kv_backend(backend)
+    return backend
