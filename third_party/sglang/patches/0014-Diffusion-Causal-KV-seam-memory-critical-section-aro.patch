From: Tianyu9748 <54686548+Tianyu9748@users.noreply.github.com>
Date: Fri, 16 Oct 2026 02:56:37 -0400
Subject: [PATCH 14/26] [Diffusion] Causal KV seam: memory-critical section
 around the VAE decode

An attached backend that declares memory_critical_section(reason, request_id=...)
is registered at attach; DecodingStage runs its VAE decode inside
causal_kv_memory_critical_section("vae_decode", batch), so background archival
can defer its GPU work there (ReelCache: ArchivePipeline.defer_gpu_work). A no-op
context without --reelcache-enable or without a declaring backend.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 .../layers/kvcache/causal_kv_backend.py       | 25 +++++
 .../runtime/pipelines_core/stages/decoding.py |  6 +-
 .../unit/test_causal_kv_session_controls.py   | 91 +++++++++++++++++++
 3 files changed, 121 insertions(+), 1 deletion(-)

diff --git a/python/sglang/multimodal_gen/runtime/layers/kvcache/causal_kv_backend.py b/python/sglang/multimodal_gen/runtime/layers/kvcache/causal_kv_backend.py
index 22efe951fb..74c8ad3144 100644
--- a/python/sglang/multimodal_gen/runtime/layers/kvcache/causal_kv_backend.py
+++ b/python/sglang/multimodal_gen/runtime/layers/kvcache/causal_kv_backend.py
@@ -333,6 +333,30 @@ def assign_causal_attention_layer_indices(blocks: Sequence[Any]) -> None:
             attention.layer_index = index
 
 
+# --- memory-critical sections -----------------------------------------------------
+
+_MEMORY_CRITICAL: Callable[..., Any] | None = None
+
+
+def causal_kv_memory_critical_section(reason: str, batch: Any = None):
+    """A memory-critical section of this worker (e.g. the VAE decode).
+
+    The attached backend's ``memory_critical_section(reason, request_id=...)``
+    when it declares one (``--reelcache-enable``: background archival defers its GPU
+    work there); a no-op context otherwise (always when disabled).
+    """
+    section = _MEMORY_CRITICAL
+    if section is None:
+        return contextlib.nullcontext()
+    return section(reason, request_id=getattr(batch, "request_id", None))
+
+
+def _register_memory_critical_section(backend: Any) -> None:
+    global _MEMORY_CRITICAL
+    section = getattr(backend, "memory_critical_section", None)
+    _MEMORY_CRITICAL = section if callable(section) else None
+
+
 # --- worker attachment ---------------------------------------------------------
 
 
@@ -388,4 +412,5 @@ def attach_causal_kv_backend(pipeline: Any, server_args: Any) -> CausalKVBackend
     )
     for stage in stages:
         stage.set_causal_kv_backend(backend)
+    _register_memory_critical_section(backend)
     return backend
