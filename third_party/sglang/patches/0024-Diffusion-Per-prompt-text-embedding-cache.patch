+    assert all(t.device.type == device for t in tensors(hit))
+    assert {t.dtype for t in tensors(hit)} == {t.dtype for t in tensors(uncached)}
+    assert cache.stats()["hits"] == 2 and cache.stats()["misses"] == 1 and cache.stats()["stores"] == 1
