+def _worker(forward):
+    worker = GPUWorker.__new__(GPUWorker)
+    worker.pipeline = SimpleNamespace(forward=forward)
+    worker.server_args = SimpleNamespace()
+    worker.causal_kv_backend = None
+    worker.is_output_rank = True
+
+    def common(req, *, forward_fn, return_req, **kwargs):
+        output = forward_fn()
+        worker._materialize_frame_outputs_for_return(output, req)
+        return output
+
+    worker._execute_forward_common = common
+    return worker
+
