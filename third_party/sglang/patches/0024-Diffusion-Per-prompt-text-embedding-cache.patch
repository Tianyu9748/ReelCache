+# --- optional text-embedding cache (workload-v2 benchmark) -------------------
+
+WL_EMBED_CACHE_ENV = "SGLANG_WL_EMBED_CACHE_BYTES"
+
+
+class TextEmbeddingCache:
+    """Host LRU of ``TextEncodingStage.encode_text`` outputs, one entry per prompt, bounded in bytes.
+
+    Process-wide and off by default: ``SGLANG_WL_EMBED_CACHE_BYTES`` (bytes,
+    default 0) > 0 enables it (:func:`text_embedding_cache`); off,
+    ``encode_text`` runs exactly as before. The key (:func:`text_embedding_key`)
+    is (text-encoder identity: model path(s), revision, stage, pipeline-config,
+    encoder, tokenizer and pre/postprocessing objects, encoder dtypes,
+    tokenizer and encoder settings, conditioning-weights epoch, autocast state;
+    call settings: encoder indices, attention masks, return type, output
+    device and dtype, max_length and the other overrides; sha256 of the
+    prompt). An entry holds that prompt's encoder output exactly as produced (a
+    pinned host copy of each tensor); a hit copies it back to the tensor's
+    original device with its dtype and strides, so a hit is bitwise the miss
+    that stored it.
+
+    A prompt list is served one prompt at a time: each distinct prompt is a hit
+    or a miss (its own encoder call) and the rows are stacked in list order,
+    which equals one encoder call per prompt. A batched call over the list need
+    not be bitwise equal to that (the umt5 encoder is not batch-invariant), so
+    with the cache on, multi-prompt lists (LongLive 2.0 block prompts) get
+    per-prompt embeddings; single-prompt calls are unchanged. Hits and misses
+    are counted here and timed as the request's ``text_encode_cached`` /
+    ``text_encode`` workload-timer spans.
+    """
+
+    def __init__(self, max_bytes: int) -> None:
+        if int(max_bytes) <= 0:
+            raise ValueError("text-embedding cache capacity must be positive")
+        self.max_bytes = int(max_bytes)
+        self.bytes = 0
+        self.hits = self.misses = self.stores = self.evictions = self.bypasses = 0
+        self._entries: OrderedDict = OrderedDict()
+
+    def __len__(self) -> int:
+        return len(self._entries)
+
+    def __contains__(self, key) -> bool:
+        return key in self._entries
+
+    def keys(self) -> list:
+        """Keys from least to most recently used."""
+        return list(self._entries)
+
+    def stats(self) -> dict:
+        return {
+            "hits": self.hits,
+            "misses": self.misses,
+            "stores": self.stores,
+            "evictions": self.evictions,
+            "bypasses": self.bypasses,
+            "entries": len(self._entries),
+            "bytes": self.bytes,
+            "max_bytes": self.max_bytes,
+        }
+
+    def clear(self) -> None:
+        self._entries.clear()
+        self.bytes = 0
+
+    def lookup(self, key):
+        """The entry of ``key`` (a hit; now the most recently used) or None (a miss)."""
+        entry = self._entries.get(key)
+        if entry is None:
+            self.misses += 1
+            return None
+        self.hits += 1
+        self._entries.move_to_end(key)
+        return entry
+
+    def store(self, key, output) -> bool:
+        """Keep a host copy of ``output`` under ``key``, evicting the least recently
+        used entries to fit; False when it is not kept (larger than the capacity,
+        or not a structure of dense tensors and plain values)."""
+        try:
+            size = _encoded_bytes(output)
+            if size > self.max_bytes:
+                raise Uncacheable("larger than the cache")
+            entry = _EmbeddingEntry.snapshot(output, size)
+        except Uncacheable:
+            self.bypasses += 1
+            return False
+        old = self._entries.pop(key, None)
+        if old is not None:
+            self.bytes -= old.size
+        while self._entries and self.bytes + size > self.max_bytes:
+            _, evicted = self._entries.popitem(last=False)
+            self.bytes -= evicted.size
+            self.evictions += 1
+        self._entries[key] = entry
+        self.bytes += size
+        self.stores += 1
+        return True
+
+
+class _EmbeddingEntry:
+    __slots__ = ("output", "size", "ready")
+
+    def __init__(self, output, size: int, ready: tuple) -> None:
+        self.output = output  # the output structure with _HostTensor leaves
+        self.size = size
+        self.ready = ready  # events after the device-to-host copies
+
+    @classmethod
+    def snapshot(cls, output, size: int) -> "_EmbeddingEntry":
+        copies: dict[int, _HostTensor] = {}
+        streams = {}
+
+        def copy(tensor):
+            if id(tensor) not in copies:
+                if (
+                    type(tensor) is not torch.Tensor
+                    or tensor.layout != torch.strided
+                    or tensor.requires_grad
+                ):
+                    raise Uncacheable("only dense inference tensors are cached")
+                host = None
+                if tensor.device.type == "cuda":
+                    stream = torch.cuda.current_stream(tensor.device)
+                    try:
+                        host = torch.empty_like(tensor, device="cpu", pin_memory=True)
+                        host.copy_(tensor.detach(), non_blocking=True)
+                        streams[tensor.device] = stream
+                    except RuntimeError:  # no pinned memory: a synchronous copy
+                        host = None
+                if host is None:
+                    host = tensor.detach().to("cpu", copy=True)
+                copies[id(tensor)] = _HostTensor(host, tensor.device)
+            return copies[id(tensor)]
+
+        stored = _map_output(output, copy)
+        ready = []
+        for stream in streams.values():
+            event = torch.cuda.Event()
+            event.record(stream)
+            ready.append(event)
+        return cls(stored, size, tuple(ready))
+
+    def restore(self):
+        """A copy of the stored output on the original devices (stream-ordered after
+        the snapshot copies; nothing is read on the host)."""
+        for event in self.ready:
+            torch.cuda.current_stream(event.device).wait_event(event)
+        restored: dict[int, torch.Tensor] = {}
+
+        def back(host: _HostTensor):
+            if id(host) not in restored:
+                restored[id(host)] = host.data.to(
+                    host.device, copy=True, non_blocking=host.device.type == "cuda"
+                )
+            return restored[id(host)]
+
+        return _map_output(self.output, back, restore=True)
+
+
+def _encoded_bytes(output) -> int:
+    sizes: dict[int, int] = {}
+
+    def count(tensor):
+        sizes[id(tensor)] = tensor.numel() * tensor.element_size()
+        return tensor
+
+    _map_output(output, count)
+    return sum(sizes.values())
+
+
+_TEXT_EMBEDDING_CACHE: TextEmbeddingCache | None = None
+_TEXT_EMBEDDING_CACHE_SETTING: str | None = None
+
+
+def text_embedding_cache() -> TextEmbeddingCache | None:
+    """The process's text-embedding cache; None unless ``SGLANG_WL_EMBED_CACHE_BYTES`` > 0
+    (a new, empty cache whenever the setting changes)."""
+    global _TEXT_EMBEDDING_CACHE, _TEXT_EMBEDDING_CACHE_SETTING
+    setting = os.environ.get(WL_EMBED_CACHE_ENV, "").strip()
+    if setting != _TEXT_EMBEDDING_CACHE_SETTING:
+        try:
+            capacity = int(setting or "0")
+        except ValueError:
+            raise ValueError(
+                f"{WL_EMBED_CACHE_ENV} must be a number of bytes, got {setting!r}"
+            ) from None
+        if capacity < 0:
+            raise ValueError(f"{WL_EMBED_CACHE_ENV} must be >= 0, got {capacity}")
+        _TEXT_EMBEDDING_CACHE = TextEmbeddingCache(capacity) if capacity else None
+        _TEXT_EMBEDDING_CACHE_SETTING = setting
+    return _TEXT_EMBEDDING_CACHE
+
+
+def _key_material(value):
+    """A repr-stable form of a key component (objects by type and process-local id)."""
+    if value is None or isinstance(value, (bool, int, float, str, bytes)):
+        return value
+    if isinstance(value, (torch.dtype, torch.device)):
+        return str(value)
+    if isinstance(value, dict):
+        items = [(repr(_key_material(k)), _key_material(v)) for k, v in value.items()]
+        return ("dict", tuple(sorted(items, key=lambda item: item[0])))
+    if isinstance(value, (list, tuple)):
+        return (type(value).__name__, tuple(_key_material(v) for v in value))
+    if inspect.isclass(value):
+        return ("class", value.__module__, value.__qualname__)
+    if inspect.ismethod(value):
+        return ("method", _key_material(value.__func__), id(value.__self__))
+    if inspect.isfunction(value):
+        return ("function", value.__module__, value.__qualname__, id(value))
+    return ("object", type(value).__module__, type(value).__qualname__, id(value))
+
+
+def _digest(material) -> str:
+    return hashlib.sha256(repr(_key_material(material)).encode("utf-8")).hexdigest()
+
+
+def _encoder_indices(encoder_index) -> list[int]:
+    if encoder_index is None:
+        return [0]
+    if isinstance(encoder_index, int):
+        return [encoder_index]
+    return list(encoder_index)
+
+
+def _text_embedding_scope(stage, server_args, settings: dict) -> tuple[str, str]:
+    """(text-encoder identity, call settings) digests shared by the prompts of one call."""
+    config = server_args.pipeline_config
+    extra_args = getattr(config, "text_encoder_extra_args", None) or []
+    indices = _encoder_indices(settings.get("encoder_index"))
+    encoders = []
+    for i in indices:
+        encoder = stage.text_encoders[i]
+        parameter = (
+            next(encoder.parameters(), None)
+            if isinstance(encoder, torch.nn.Module)
+            else None
+        )
+        encoder_config = config.text_encoder_configs[i]
+        encoders.append(
+            (
+                i,
+                type(encoder),
+                id(encoder),
+                None if parameter is None else parameter.dtype,
+                type(stage.tokenizers[i]),
+                id(stage.tokenizers[i]),
+                getattr(encoder_config, "tokenizer_kwargs", None),
+                getattr(getattr(encoder_config, "arch_config", None), "text_len", None),
+                extra_args[i] if i < len(extra_args) else None,
+                config.preprocess_text_funcs[i],
+                config.postprocess_text_funcs[i],
+            )
+        )
+    identity = (
+        "sglang.wl_text_embedding.v1",
+        getattr(server_args, "model_path", None),
+        getattr(server_args, "model_paths", None),
+        getattr(server_args, "revision", None),
+        type(stage),
+        type(config),
+        id(config),
+        tuple(encoders),
+        conditioning_weights_epoch(),
+        torch.is_autocast_enabled("cuda"),
+        torch.get_autocast_dtype("cuda"),
+        torch.is_autocast_enabled("cpu"),
+        torch.get_autocast_dtype("cpu"),
+    )
+    device = settings.get("device")
+    call = (
+        tuple(indices),
+        {**settings, "device": device if device is not None else get_local_torch_device()},
+    )
+    return _digest(identity), _digest(call)
+
+
+def text_embedding_key(stage, server_args, prompt: str, settings: dict) -> tuple[str, str, str]:
+    """Cache key of ``prompt`` encoded by ``stage.encode_text(prompt, server_args, **settings)``:
+    (text-encoder identity, call settings, prompt sha256), hex digests."""
+    identity, call = _text_embedding_scope(stage, server_args, settings)
+    return identity, call, hashlib.sha256(prompt.encode("utf-8")).hexdigest()
+
+
+def _cacheable_text_call(text, settings: dict) -> bool:
+    if not (
+        isinstance(text, str)
+        or (
+            isinstance(text, list)
+            and text
+            and all(isinstance(item, str) for item in text)
+        )
+    ):
+        return False
+    if settings.get("return_type", "list") not in ("list", "dict"):
+        return False
+    if torch.is_grad_enabled() or torch.compiler.is_compiling():
+        return False
+    if torch.cuda.is_available() and torch.cuda.is_current_stream_capturing():
+        return False
+    # one cache per rank: ranks whose hits differed would skip encoder collectives
+    return not (
+        torch.distributed.is_available()
+        and torch.distributed.is_initialized()
+        and torch.distributed.get_world_size() > 1
+    )
+
+
+def _is_row_value_list(value) -> bool:
+    return bool(value) and all(
+        isinstance(item, (int, float)) and not isinstance(item, bool) for item in value
+    )
+
+
+def _one_row(value) -> bool:
+    """Whether an encoder output describes exactly one prompt row (stackable)."""
+    if value is None:
+        return True
+    if isinstance(value, torch.Tensor):
+        return value.dim() >= 1 and value.shape[0] == 1
+    if isinstance(value, dict):
+        return all(_one_row(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        if _is_row_value_list(value):
+            return len(value) == 1
+        return all(_one_row(item) for item in value)
+    return False
+
+
+def _stack_rows(parts: list):
+    """The per-prompt outputs stacked into the structure of one call over all rows."""
+    first = parts[0]
+    if first is None:
+        if any(part is not None for part in parts):
+            raise ValueError("per-prompt text encodings differ in structure")
+        return None
+    if isinstance(first, torch.Tensor):
+        return torch.cat(parts, dim=0)
+    if isinstance(first, dict):
+        return {key: _stack_rows([part[key] for part in parts]) for key in first}
+    if isinstance(first, (list, tuple)):
+        if _is_row_value_list(first):
+            return [item for part in parts for item in part]
+        if any(len(part) != len(first) for part in parts):
+            raise ValueError("per-prompt text encodings differ in structure")
+        items = [_stack_rows([part[i] for part in parts]) for i in range(len(first))]
+        return items if isinstance(first, list) else tuple(items)
+    raise TypeError(f"cannot stack text-encoder output of type {type(first).__name__}")
+
+
+def _timer_span(timer, name: str):
+    return nullcontext() if timer is None else timer.span(name)
+
+
+def _text_embedding_cached(encode_text):
+    """``TextEncodingStage.encode_text`` with the optional text-embedding cache and the
+    workload timer's ``text_encode`` / ``text_encode_cached`` spans; without both it is
+    the plain call."""
+    signature = inspect.signature(encode_text)
+
+    @functools.wraps(encode_text)
+    def wrapper(self, text, server_args, *args, **kwargs):
+        cache = text_embedding_cache()
+        timer = current_workload_timer()
+        if cache is None:
+            if timer is None:
+                return encode_text(self, text, server_args, *args, **kwargs)
+            with timer.span(TEXT_ENCODE):
+                return encode_text(self, text, server_args, *args, **kwargs)
+        bound = signature.bind(self, text, server_args, *args, **kwargs)
+        bound.apply_defaults()
+        settings = {
+            name: value
+            for name, value in bound.arguments.items()
+            if name not in ("self", "text", "server_args")
+        }
+        if not _cacheable_text_call(text, settings):
+            cache.bypasses += 1
+            with _timer_span(timer, TEXT_ENCODE):
+                return encode_text(self, text, server_args, *args, **kwargs)
+        prompts = [text] if isinstance(text, str) else list(text)
+        identity, call = _text_embedding_scope(self, server_args, settings)
+        outputs = {}
+        missed = False
+        for prompt in dict.fromkeys(prompts):
+            key = (identity, call, hashlib.sha256(prompt.encode("utf-8")).hexdigest())
+            entry = cache.lookup(key)
+            if entry is not None:
+                with _timer_span(timer, TEXT_ENCODE_CACHED):
+                    outputs[prompt] = entry.restore()
+                continue
+            missed = True
+            with _timer_span(timer, TEXT_ENCODE):
+                output = encode_text(self, [prompt], server_args, **settings)
+                cache.store(key, output)
+            outputs[prompt] = output
+        if not missed:
+            # as on a conditioning-cache hit: weights retained by an earlier use are released
+            for i in _encoder_indices(settings.get("encoder_index")):
+                self.finish_unused_declared_component(
+                    component_name="text_encoder" if i == 0 else f"text_encoder_{i + 1}",
+                    module=self.text_encoders[i],
+                )
+        if len(prompts) == 1:
+            return outputs[prompts[0]]
+        parts = [outputs[prompt] for prompt in prompts]
+        try:
+            if all(_one_row(part) for part in parts):
+                return _stack_rows(parts)
+        except (TypeError, ValueError, RuntimeError, KeyError, IndexError):
+            pass
+        # not one stackable row per prompt (e.g. 2-D embeddings): the plain batched call
+        cache.bypasses += 1
+        with _timer_span(timer, TEXT_ENCODE):
+            return encode_text(self, text, server_args, *args, **kwargs)
+
+    return wrapper
+
