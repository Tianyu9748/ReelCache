+    def _causal_kv_conditioning(self, batch: Req, server_args: ServerArgs) -> dict:
+        """JSON identity of the generation-affecting request fields (no live objects)."""
+        identity: dict[str, Any] = {"model_path": server_args.model_path}
+        params = batch.sampling_params
+        if params is not None and dataclasses.is_dataclass(params):
+            for item in dataclasses.fields(params):
+                if item.name in self._CAUSAL_KV_IDENTITY_EXCLUDE:
+                    continue
+                value = getattr(params, item.name, None)
+                if isinstance(value, Enum):
+                    value = value.value
+                try:
+                    identity[item.name] = json.loads(json.dumps(value))
+                except (TypeError, ValueError):
+                    identity[item.name] = {"unserializable": type(value).__name__}
+        return identity
+
+    def _begin_causal_kv_run(
+        self,
+        batch: Req,
+        server_args: ServerArgs,
+        *,
+        ctx: CausalDMDForwardContext,
+        block_sizes: list[int],
+        pos_start_base: int,
+        use_cfg: bool,
+        kv_cache,
+        kv_cache_neg,
+        latents: torch.Tensor,
+    ) -> tuple[Any, int]:
+        """Open the backend run of a session request and install restored history.
+
+        Returns ``(None, 0)`` on the ordinary path. Otherwise the run and the
+        number of leading blocks already restored from the session archive.
+        """
+        backend = self._causal_kv_backend
+        if backend is None:
+            return None, 0
+        session = validate_causal_kv_session(getattr(batch, "causal_kv_session", None))
+        if session is None:
+            return None, 0
+        if latents.shape[0] != 1:
+            raise ValueError("causal KV sessions support one sample per request")
+        if getattr(batch, "image_latent", None) is not None:
+            raise NotImplementedError(
+                "causal KV sessions do not support image-conditioned warm-up yet"
+            )
+        if self._causal_sequence_shard_enabled(batch):
+            raise NotImplementedError("causal KV sessions do not support sequence sharding")
+        transformer = self.transformer
+        rope = getattr(transformer, "causal_rotary_cos_sin", None)
+        rotate_key = getattr(transformer, "causal_rotate_key", None)
+        if rope is None or rotate_key is None:
+            raise NotImplementedError(
+                f"{type(transformer).__name__} exposes no causal RoPE for restored history"
+            )
+        patch = transformer.config.patch_size
+        grid = (ctx.height // patch[-2], ctx.width // patch[-1])
+        streams = ("cond", "uncond") if use_cfg else ("cond",)
+        request = CausalKVRequest(
+            request_id=getattr(batch, "request_id", None),
+            session=session,
+            conditioning=self._causal_kv_conditioning(batch, server_args),
+            block_sizes=tuple(int(size) for size in block_sizes),
+            tokens_per_frame=int(self.num_token_per_frame),
+            grid=grid,
+            pos_start_base=int(pos_start_base),
+            streams=streams,
+            num_layers=int(self.num_transformer_blocks),
+            num_heads=int(kv_cache[0].k.shape[2]),
+            head_dim=int(kv_cache[0].k.shape[3]),
+            dtype=str(kv_cache[0].k.dtype).removeprefix("torch."),
+            model={
+                "pipeline_stage": type(self).__name__,
+                "transformer": type(transformer).__name__,
+                "model_path": server_args.model_path,
+                "num_frames_per_block": int(self.num_frames_per_block),
+                "cache_tokens": int(kv_cache[0].cache_size),
+                "sink_tokens": int(kv_cache[0].sink_tokens),
+                "global_sink_tokens": int(kv_cache[0].global_sink_tokens),
+                "attention_window_tokens": int(kv_cache[0].attention_window_size),
+            },
+        )
+        run = backend.begin_request(request)
+        if run is None:
+            return None, 0
+        device = latents.device
+        caches = {"cond": kv_cache}
+        if use_cfg:
+            caches["uncond"] = kv_cache_neg
+        try:
+            resume_blocks = run.restore(
+                CausalKVRestoreTarget(
+                    caches=caches,
+                    latents=latents,
+                    generator=batch.generator,
+                    rope_cos_sin=lambda start, frames: rope(
+                        frames, grid[0], grid[1], start_frame=start, device=device
+                    ),
+                    rotate_key=rotate_key,
+                    device=device,
+                )
+            )
+        except BaseException as exc:
+            run.finish(error=exc)
+            raise
+        return run, int(resume_blocks)
+
+    def _causal_kv_chunk(
+        self,
+        batch: Req,
+        *,
+        block_index: int,
+        start_frame: int,
+        num_frames: int,
+        pos_start_base: int,
+        scene_cut: bool,
+    ) -> CausalKVChunk:
+        tokens = num_frames * self.num_token_per_frame
+        return CausalKVChunk(
+            index=block_index,
+            start_frame=start_frame,
+            num_frames=num_frames,
+            token_start=(pos_start_base + start_frame) * self.num_token_per_frame,
+            num_tokens=tokens,
+            rope_start_frame=self._causal_rope_start_frame(start_frame),
+            scene_cut=scene_cut,
+            shot_index=self._shot_index(batch, block_index),
+        )
+
+    @contextmanager
+    def _causal_kv_run_scope(self, run):
+        """Report a failed request to the backend run; clears pending capture state."""
+        try:
+            yield
+        except BaseException as exc:
+            self._causal_kv_pending = None
+            if run is not None:
+                run.finish(error=exc)
+            raise
+
     def _target_dtype(self) -> torch.dtype:
         return torch.bfloat16
 
