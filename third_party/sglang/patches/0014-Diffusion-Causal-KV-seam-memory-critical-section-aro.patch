                 latents, keep_latents = _causal_kv_decode_window(batch)
                 frames = self.decode(latents, server_args, vae_dtype=vae_dtype)
                 if keep_latents is not None:
diff --git a/python/sglang/multimodal_gen/test/unit/test_causal_kv_session_controls.py b/python/sglang/multimodal_gen/test/unit/test_causal_kv_session_controls.py
index d407aab1c1..3d6edef339 100644
--- a/python/sglang/multimodal_gen/test/unit/test_causal_kv_session_controls.py
+++ b/python/sglang/multimodal_gen/test/unit/test_causal_kv_session_controls.py
@@ -448,3 +448,94 @@ def test_provider_pipelines_attach_the_backend_without_causal_stages(monkeypatch
 
     with pytest.raises(ReelCacheUnavailableError):
         seam.attach_causal_kv_backend(SimpleNamespace(stages=[]), args)
+
+
+def _recording_section(seen):
+    import contextlib
+
+    @contextlib.contextmanager
+    def section(reason, request_id=None):
+        seen.append(("enter", reason, request_id))
+        yield {"reason": reason}
+        seen.append(("exit", reason, request_id))
+
+    return section
+
+
+def test_memory_critical_section_is_a_noop_unless_the_backend_declares_one(
+    monkeypatch,
+):
+    seen = []
+    monkeypatch.setattr(seam, "_MEMORY_CRITICAL", None)
+    with seam.causal_kv_memory_critical_section(
+        "vae_decode", SimpleNamespace(request_id="r0")
+    ):
+        seen.append(("body",))
+    assert seen == [("body",)]
+    seen.clear()
+    seam._register_memory_critical_section(
+        SimpleNamespace(memory_critical_section=_recording_section(seen))
+    )
+    with seam.causal_kv_memory_critical_section(
+        "vae_decode", SimpleNamespace(request_id="r1")
+    ):
+        seen.append(("body",))
+    assert seen == [
+        ("enter", "vae_decode", "r1"),
+        ("body",),
+        ("exit", "vae_decode", "r1"),
+    ]
+    seam._register_memory_critical_section("a backend without sections")
+    assert seam._MEMORY_CRITICAL is None
+
+
+def test_decoding_stage_decodes_inside_the_memory_critical_section(monkeypatch):
+    import contextlib
+
+    seen = []
+    monkeypatch.setattr(seam, "_MEMORY_CRITICAL", _recording_section(seen))
+    stage = object.__new__(decoding.DecodingStage)
+    stage.component_name = "vae"
+    stage.vae = object()
+
+    @contextlib.contextmanager
+    def declared(self, component_name, module):
+        yield module
+
+    monkeypatch.setattr(decoding.DecodingStage, "load_model", lambda self: None)
+    monkeypatch.setattr(decoding.DecodingStage, "use_declared_component", declared)
+    monkeypatch.setattr(
+        decoding.DecodingStage,
+        "decode",
+        lambda self, latents, server_args, vae_dtype=None: seen.append(("decode",))
+        or latents,
+    )
+    monkeypatch.setattr(
+        decoding, "resolve_decode_precision", lambda *a, **k: torch.float32
+    )
+    monkeypatch.setattr(
+        decoding, "use_vae_fast_path", lambda vae, allowed: contextlib.nullcontext()
+    )
+    monkeypatch.setattr(decoding, "quality_allows_kernel_fusions", lambda q: False)
+    batch = SimpleNamespace(
+        request_id="job-1",
+        extra={},
+        latents=torch.zeros(1, 1, 2, 1, 1),
+        sampling_params=SimpleNamespace(quality=None),
+        return_trajectory_decoded=False,
+        trajectory_timesteps=None,
+        trajectory_latents=None,
+        rollout_trajectory_data=None,
+        metrics=None,
+        usage=None,
+    )
+    server_args = SimpleNamespace(
+        pipeline_config=SimpleNamespace(post_decoding=lambda frames, args: frames)
+    )
+    output = decoding.DecodingStage.forward(stage, batch, server_args)
+    assert isinstance(output, OutputBatch)
+    assert seen == [
+        ("enter", "vae_decode", "job-1"),
+        ("decode",),
+        ("exit", "vae_decode", "job-1"),
+    ]
