+    def set_causal_kv_backend(self, backend: Any) -> None:
+        """Attach the worker's causal KV archive backend (see causal_kv_backend.py)."""
+        self._causal_kv_backend = backend
+
+    def _causal_kv_capture_scope(self, kv_cache):
+        pending = self._causal_kv_pending
+        if pending is None:
+            return nullcontext()
+        run, chunk = pending
+        return causal_kv_capture_scope(run, chunk, kv_cache)
+
+    def _causal_rope_start_frame(self, start_frame: int):
+        """Temporal RoPE start frame the transformer receives for ``start_frame``."""
+        return start_frame
