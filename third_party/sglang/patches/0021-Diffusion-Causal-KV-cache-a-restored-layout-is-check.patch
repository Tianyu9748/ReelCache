@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: Apache-2.0
 
+import functools
 import itertools
 from collections.abc import Callable, Sequence
 from dataclasses import dataclass, field
@@ -105,6 +106,29 @@ def _check_restored_layout(layout: "CausalKVCacheLayout") -> None:
             raise ValueError("restored span is not part of the live layout")
 
 
+# A restore installs one layout into every layer's cache (a cached plan reuses it
+# across requests): its checks run once per layout value. Errors are not cached.
+_checked_layout = functools.lru_cache(maxsize=64)(_check_restored_layout)
+
+
+@functools.lru_cache(maxsize=64)
+def _unwritten_slots(layout: "CausalKVCacheLayout") -> tuple[tuple[int, int], ...]:
+    """Live slots ``[0, local_end)`` outside every attended span: the slots a
+    restore does not write (live but not attended, evicted by the next append
+    before any read). None attended means every live slot is written."""
+    if layout.attended is None:
+        return ()
+    holes, cursor = [], 0
+    attended = sorted((span.local_start, span.local_end) for span in layout.attended)
+    for start, end in attended:
+        if start > cursor:
+            holes.append((cursor, min(start, layout.local_end_index)))
+        cursor = max(cursor, end)
+    if cursor < layout.local_end_index:
+        holes.append((cursor, layout.local_end_index))
+    return tuple((start, end) for start, end in holes if end > start)
+
+
