+@pytest.fixture
+def cache_bytes(monkeypatch):
+    """Set ``SGLANG_WL_EMBED_CACHE_BYTES`` and start from a fresh process cache."""
+
+    def set_bytes(value):
+        monkeypatch.setenv(te.WL_EMBED_CACHE_ENV, str(value))
+        monkeypatch.setattr(te, "_TEXT_EMBEDDING_CACHE", None)
+        monkeypatch.setattr(te, "_TEXT_EMBEDDING_CACHE_SETTING", None)
+        return te.text_embedding_cache()
+
+    monkeypatch.delenv(te.WL_EMBED_CACHE_ENV, raising=False)
+    monkeypatch.setattr(te, "_TEXT_EMBEDDING_CACHE", None)
+    monkeypatch.setattr(te, "_TEXT_EMBEDDING_CACHE_SETTING", None)
+    return set_bytes
+
+
+def tensors(value):
+    """The tensors of an encode_text output, in structure order."""
+    if isinstance(value, torch.Tensor):
+        return [value]
+    if isinstance(value, dict):
+        return [t for item in value.values() for t in tensors(item)]
+    if isinstance(value, (list, tuple)):
+        return [t for item in value for t in tensors(item)]
+    return []
+
+
+def bits(tensor):
+    tensor = tensor.detach()
+    if tensor.dtype == torch.bool:
+        return tensor.to(torch.uint8)
+    return tensor.view(torch.int16) if tensor.element_size() == 2 else tensor.view(torch.int32 if tensor.element_size() == 4 else torch.int64)
+
+
+def assert_bitwise(left, right):
+    """Same structure, same plain values, tensors equal bit for bit with the same dtype, device and shape."""
+    assert type(left) is type(right)
+    if isinstance(left, torch.Tensor):
+        assert (left.dtype, left.device, left.shape) == (right.dtype, right.device, right.shape)
+        assert torch.equal(bits(left), bits(right))
+    elif isinstance(left, dict):
+        assert list(left) == list(right)
+        for key in left:
+            assert_bitwise(left[key], right[key])
+    elif isinstance(left, (list, tuple)):
+        assert len(left) == len(right)
+        for a, b in zip(left, right):
+            assert_bitwise(a, b)
+    else:
+        assert left == right
+
+
+def snapshot(value):
+    if isinstance(value, torch.Tensor):
+        return value.clone()
+    if isinstance(value, dict):
+        return {k: snapshot(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return type(value)(snapshot(v) for v in value)
+    return value
+
+
+def encode(stage, text, args, device, **kwargs):
+    kwargs.setdefault("return_attention_mask", True)
+    return stage.encode_text(text, args, device=device, **kwargs)
+
