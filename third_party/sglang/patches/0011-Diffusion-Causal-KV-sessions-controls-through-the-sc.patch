+def test_session_handle_output_fields():
+    handle = seam.validate_causal_kv_session(
+        {
+            "session_id": "s",
+            "action": "resume",
+            "output": "full",
+            "decode_context_latents": 4,
+        }
+    )
+    assert (handle["output"], handle["decode_context_latents"]) == ("full", 4)
+    assert "output" not in seam.validate_causal_kv_session({"session_id": "s"})
+    for bad in (
+        {"session_id": "s", "output": "all"},
+        {"session_id": "s", "decode_context_latents": 0},
+        {"session_id": "s", "decode_context_latents": 1.5},
+    ):
+        with pytest.raises(ValueError):
+            seam.validate_causal_kv_session(bad)
