+def test_key_changes_with_every_encoder_and_call_setting():
+    encoder = BatchVariantEncoder()
+    stage, args = make_stage([encoder]), make_args()
+    config = args.pipeline_config
+    base_settings = dict(
+        encoder_index=None,
+        return_attention_mask=True,
+        return_type="list",
+        device="cpu",
+        dtype=None,
+        max_length=None,
+        truncation=None,
+        padding=None,
+        return_overflowing_tokens=None,
+        return_length=None,
+    )
+
+    def key(prompt="a", stage=stage, **changes):
+        return te.text_embedding_key(stage, args, prompt, {**base_settings, **changes})
+
+    base = key()
+    assert base == key() and len(base) == 3 and all(isinstance(part, str) for part in base)
+    assert base[2] == hashlib.sha256(b"a").hexdigest()
+    assert key("b")[:2] == base[:2] and key("b")[2] != base[2]  # one scope for every prompt of a call
+
+    def changed(target, name, value):
+        """The key with one attribute / item of the live objects changed, then restored."""
+        getter, setter = (
+            (lambda: target[name], lambda v: target.__setitem__(name, v))
+            if isinstance(target, (dict, list))
+            else (lambda: getattr(target, name, None), lambda v: setattr(target, name, v))
+        )
+        before = getter()
+        setter(value)
+        try:
+            return key()
+        finally:
+            setter(before)
+
+    variants = {
+        # call settings
+        "max_length": key(max_length=8),
+        "dtype": key(dtype=torch.bfloat16),
+        "device": key(device="meta"),
+        "masks": key(return_attention_mask=False),
+        "return_type": key(return_type="dict"),
+        "encoder_index": key(encoder_index=[0]),
+        "padding": key(padding="max_length"),
+        # text-encoder identity (each changed alone on the same objects)
+        "tokenizer_kwargs": changed(config.text_encoder_configs[0], "tokenizer_kwargs", {"max_length": 512}),
+        "text_len": changed(config.text_encoder_configs[0], "arch_config", SimpleNamespace(text_len=512)),
+        "preprocess": changed(config.preprocess_text_funcs, 0, str.lower),
+        "postprocess": changed(config.postprocess_text_funcs, 0, _postprocess_other),
+        "extra_args": changed(config, "text_encoder_extra_args", [{"add_special_tokens": False}]),
+        "model_path": changed(args, "model_path", "/models/longlive2/snapshots/rev-b"),
+        "text_encoder_path": changed(args.model_paths, "text_encoder", "/models/other/text_encoder"),
+        "revision": changed(args, "revision", "rev-b"),
+        "encoder_object": key(stage=make_stage([BatchVariantEncoder()])),
+        "stage_class": key(stage=make_stage([encoder], LongLive2TextEncodingStage)),
+    }
+    assert key() == base  # every change was undone
+    with torch.no_grad():
+        encoder.weight.data = encoder.weight.data.to(torch.bfloat16)
+        variants["encoder_dtype"] = key()
+        encoder.weight.data = encoder.weight.data.to(torch.float32)
+    for name, variant in variants.items():
+        assert variant[:2] != base[:2], name
+        assert variant[2] == base[2], name
+    two = make_stage([encoder, BatchVariantEncoder()])
+    args.pipeline_config = make_config(2)
+    assert te.text_embedding_key(two, args, "a", {**base_settings, "encoder_index": [0]}) != te.text_embedding_key(
+        two, args, "a", {**base_settings, "encoder_index": [1]}
+    )
+    args.pipeline_config = config
+    invalidate_conditioning_caches()  # weight updates bump the epoch: old entries are never hit again
+    assert key()[0] != base[0]
