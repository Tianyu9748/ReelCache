+# SPDX-License-Identifier: Apache-2.0
+"""Causal KV session controls over HTTP (registered only with ``--reelcache-enable``).
+
+Generation actions (generate, resume, fork, rewind, a native prompt change)
+are ordinary ``POST /v1/videos`` jobs carrying a ``causal_kv_session`` handle;
+the endpoints here control sessions without generating. Each one sends a
+``CausalKVSessionControlReq(op, args)`` to the scheduler; the worker's backend
+(``backend.control``) answers with plain JSON or a typed error
+(``{"code", "status", "message"}``, returned as that HTTP status). While a
+request runs, ``list``/``describe``/``request`` and the pause of the running
+session are answered at its next chunk boundary (a pause replies once it is
+durable); every other control waits for the running request. No endpoint
+accepts a filesystem path.
+
+=======================================================  =====================
+``GET    /v1/sessions``                                  list
+``GET    /v1/sessions/{session_id}?history=50``          describe
+``DELETE /v1/sessions/{session_id}?gc=true``             delete (+ GC)
+``GET    /v1/sessions/{session_id}/checkpoints``         checkpoints
+``POST   /v1/sessions/{session_id}/checkpoints``         checkpoint [name]
+``DELETE /v1/sessions/{session_id}/checkpoints/{name}``  delete a checkpoint
+``POST   /v1/sessions/{session_id}/open``                open (prepare)
+``POST   /v1/sessions/{session_id}/pause``               pause
+``POST   /v1/sessions/{session_id}/fork``                fork (no generation)
+``POST   /v1/sessions/{session_id}/rewind``              rewind (no generation)
+``POST   /v1/sessions/{session_id}/close``               close (drain | abort)
+``GET    /v1/session_capabilities``                      capabilities
+``GET    /v1/session_requests/{request_id}``             request summary
+``POST   /v1/session_gc``                                garbage collection
+=======================================================  =====================
+"""
+
+from typing import Any, Literal, Optional, Union
+
+from fastapi import APIRouter, HTTPException, Query
+from pydantic import BaseModel, ConfigDict
+
+from sglang.multimodal_gen.runtime.entrypoints.control_requests import (
+    CausalKVSessionControlReq,
+)
+from sglang.multimodal_gen.runtime.pipelines_core.schedule_batch import OutputBatch
+from sglang.multimodal_gen.runtime.scheduler_client import async_scheduler_client
+
+router = APIRouter(prefix="/v1", tags=["causal_kv_sessions"])
+
+
+class CheckpointBody(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    name: Optional[str] = None
+    replace: bool = False
+
+
+class ForkBody(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    target: str
+    checkpoint: Optional[Union[int, str]] = None
+
+
+class RewindBody(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    checkpoint: Union[int, str]
+
+
+class CloseBody(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    mode: Literal["drain", "abort"] = "drain"
+
+
+async def _control(op: str, **args: Any) -> dict:
+    """Send one control to the scheduler; typed errors become their HTTP status."""
+    args = {key: value for key, value in args.items() if value is not None}
+    try:
+        output = await async_scheduler_client.forward(
+            CausalKVSessionControlReq(op=op, args=args)
+        )
+    except TimeoutError as exc:
+        raise HTTPException(status_code=504, detail=str(exc)) from exc
+    if not isinstance(output, OutputBatch):
+        raise HTTPException(
+            status_code=500, detail=f"unexpected reply {type(output).__name__}"
+        )
+    result = output.output if isinstance(output.output, dict) else {}
+    if output.error is not None:
+        error = result.get("error") or {
+            "code": "internal",
+            "status": 500,
+            "message": output.error,
+        }
+        raise HTTPException(status_code=int(error.get("status", 500)), detail=error)
+    return result
+
+
+@router.get("/sessions")
+async def list_sessions():
+    return await _control("list")
+
+
+@router.get("/session_capabilities")
+async def session_capabilities():
+    return await _control("capabilities")
+
+
+@router.get("/session_requests/{request_id}")
+async def session_request(request_id: str):
+    return await _control("request", request_id=request_id)
+
+
+@router.post("/session_gc")
+async def session_gc():
+    return await _control("gc")
+
+
+@router.get("/sessions/{session_id}")
+async def describe_session(session_id: str, history: int = Query(50, ge=0)):
+    return await _control("describe", session_id=session_id, history=history)
+
+
+@router.delete("/sessions/{session_id}")
+async def delete_session(session_id: str, gc: bool = True):
+    return await _control("delete", session_id=session_id, gc=gc)
+
+
+@router.get("/sessions/{session_id}/checkpoints")
+async def session_checkpoints(session_id: str):
+    return await _control("checkpoints", session_id=session_id)
+
+
+@router.post("/sessions/{session_id}/checkpoints")
+async def create_checkpoint(session_id: str, body: Optional[CheckpointBody] = None):
+    body = body or CheckpointBody()
+    return await _control(
+        "checkpoint", session_id=session_id, name=body.name, replace=body.replace
+    )
+
+
+@router.delete("/sessions/{session_id}/checkpoints/{name}")
+async def delete_checkpoint(session_id: str, name: str, gc: bool = True):
+    return await _control("delete", session_id=session_id, checkpoint=name, gc=gc)
+
+
+@router.post("/sessions/{session_id}/open")
+async def open_session(session_id: str):
+    return await _control("open", session_id=session_id)
+
+
+@router.post("/sessions/{session_id}/pause")
+async def pause_session(session_id: str):
+    return await _control("pause", session_id=session_id)
+
+
+@router.post("/sessions/{session_id}/fork")
+async def fork_session(session_id: str, body: ForkBody):
+    return await _control(
+        "fork", session_id=session_id, target=body.target, checkpoint=body.checkpoint
+    )
+
+
+@router.post("/sessions/{session_id}/rewind")
+async def rewind_session(session_id: str, body: RewindBody):
+    return await _control("rewind", session_id=session_id, checkpoint=body.checkpoint)
+
+
+@router.post("/sessions/{session_id}/close")
+async def close_session(session_id: str, body: Optional[CloseBody] = None):
+    body = body or CloseBody()
+    return await _control("close", session_id=session_id, mode=body.mode)
