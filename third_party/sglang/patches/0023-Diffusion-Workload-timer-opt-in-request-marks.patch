+# --- t2: the first denoise forward, never a clean (context / recache) forward ------------------------------------
+
+
+class _Transformer:
+    def __init__(self, timer=None):
+        self.calls = []
+        self.timer = timer
+
+    def __call__(self, latents, prompt_embeds, timestep, **kwargs):
+        has_t2 = self.timer is not None and self.timer.has_mark("t2_first_new_denoise")
+        self.calls.append((kwargs["start_frame"], has_t2))
+        return latents * 2
+
+
+def _stage(transformer):
+    stage = CausalDMDDenoisingStage.__new__(CausalDMDDenoisingStage)
+    stage.transformer = transformer
+    stage._component_residency_manager = None
+    return stage
+
+
+def _forward(stage, batch, start_frame):
+    return stage._forward_causal_transformer(
+        batch,
+        latent_model_input=torch.ones(1, 2),
+        prompt_embeds=None,
+        timestep=torch.zeros(1),
+        kv_cache=None,
+        crossattn_cache=None,
+        current_start_tokens=0,
+        start_frame=start_frame,
+        image_kwargs={},
+        pos_cond_kwargs={},
+        current_timestep=0,
+        attn_metadata=None,
+        target_dtype=torch.float32,
+        autocast_enabled=False,
+    )
+
+
+class _CaptureRun:
+    def stream_of(self, kv_cache):
+        return "cond"
+
+    def end_clean_forward(self, capture):
+        pass
+
+
+def test_t2_skips_clean_forwards_and_marks_the_first_denoise_forward():
+    timer = wt.WorkloadTimer(cuda=False)
+    batch = SimpleNamespace(extra={"wl_timer": timer})
+    stage = _stage(_Transformer(timer))
+    # restored history is installed by the backend; a recache (or replay) forward runs as a clean forward
+    with stage._causal_kv_capture_scope("kv"):
+        _forward(stage, batch, start_frame=0)
+    # a captured clean forward of a session request is clean as well
+    chunk = seam.CausalKVChunk(0, 3, 3, 12, 12, 3, False, 0)
+    stage._causal_kv_pending = (_CaptureRun(), chunk)
+    with stage._causal_kv_capture_scope("kv"):
+        assert seam.active_causal_kv_capture() is not None
+        _forward(stage, batch, start_frame=3)
+    stage._causal_kv_pending = None
+    assert not timer.has_mark("t2_first_new_denoise") and stage._causal_clean_forwards == 0
+    before = time.monotonic_ns()
+    _forward(stage, batch, start_frame=6)  # the first denoise forward (first block not restored)
+    t2 = timer.resolve()["marks"]["t2_first_new_denoise"]["host_ns"]
+    assert t2 >= before
+    _forward(stage, batch, start_frame=6)  # later denoise forwards keep the first mark
+    with stage._causal_kv_capture_scope("kv"):  # and the block's clean forward does not move it
+        _forward(stage, batch, start_frame=6)
+    assert timer.resolve()["marks"]["t2_first_new_denoise"]["host_ns"] == t2
+    # the mark precedes the first denoise forward's launch; clean forwards before it never saw it
+    assert stage.transformer.calls == [(0, False), (3, False), (6, True), (6, True), (6, True)]
+
+
+def test_clean_forward_scope_unwinds_on_errors_and_keeps_the_capture_contract():
+    stage = _stage(_Transformer())
+    with pytest.raises(RuntimeError):
+        with stage._causal_kv_capture_scope("kv"):
+            raise RuntimeError("forward failed")
+    assert stage._causal_clean_forwards == 0
+    with stage._causal_kv_capture_scope("kv") as value:
+        assert value is None and stage._causal_clean_forwards == 1
+    events = []
+
+    class Run(_CaptureRun):
+        def end_clean_forward(self, capture):
+            events.append(capture.chunk.index)
+
+    stage._causal_kv_pending = (Run(), seam.CausalKVChunk(4, 0, 3, 0, 12, 0, False, 0))
+    with stage._causal_kv_capture_scope("kv") as scope:
+        assert seam.active_causal_kv_capture() is scope
+    with pytest.raises(RuntimeError):
+        with stage._causal_kv_capture_scope("kv"):
+            raise RuntimeError("capture failed")
+    assert events == [4] and seam.active_causal_kv_capture() is None and stage._causal_clean_forwards == 0
+
